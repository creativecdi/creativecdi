                "content": "\"\"",
                "display": "block !important",
                "position": "absolute",
                "left": "40px",
                "bottom": "2px",
                "top": "auto !important",
                "height": "1px",
                "width": "0",
                "overflow": "visible !important",
                "transform": "scale(1) !important",
                "background-color": "currentColor",
                "transition": "0.4s cubic-bezier(0.33, 0.52, 0.05, 0.96)"
              },
              "&:hover, &:focus": {
                "&:before": {
                  "width": "~\"calc(100% - 80px)\""
                }
              }
            },
