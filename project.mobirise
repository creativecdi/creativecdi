              "img": {
                "width": "100%",
                "aspect-ratio": "~\"calc(37 / (11 * @{imgHeight}))\"",
                "object-fit": "cover",
                "transform": "scale(1.01)",
                "transition": "all .5s ease"
              }
            },
            ".item-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "width": "100%",
              "height": "100%",
              "padding": "0",
              "transition": ".3s all",
              "&:hover": {
                ".item-img": {
                  "img": {
                    "transform": "scale(1.05)"
                  }
                }
              }
            },
            ".item-content": {
              "flex-grow": "1",
              "padding": "31px 42px 43px",
              "& when (@showBg)": {
                "background-color": "@bgColor"
              }
            },
            ".item-title": {
              "color": "#303030"
            },
            ".mbr-text": {
              "margin-bottom": "4px",
              "color": "#303030",
              "text-decoration": "underline"
            },
            ".icons-menu": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "gap": "4px",
              "margin-top": "12px"
            },
            ".iconfont-wrapper": {
              "padding": "11px",
              "border-radius": "50%",
              "transition": "opacity 0.2s ease-out",
              ".mbr-iconfont": {
                "font-size": "14px",
                "color": "@iconsColor",
                "transition": "all 0.2s ease-out"
              },
              "&:hover": {
                "background-color": "spin(saturate(lighten(@iconsHoverColor, 30%), 30%), 10)",
                ".mbr-iconfont": {
                  "color": "@iconsHoverColor"
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "10px"
            }
