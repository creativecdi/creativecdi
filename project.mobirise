        {
          "_name": "gallery10",
          "_sourceTheme": "startm5",
          "_styles": {},
          "_customHTML": "\n\n\n<meta charset=\"UTF-8\">\n<title>Beejay Mast Construction — Scrolling Intro</title>\n<style>\n  :root{\n    --content-color: #907401;\n    --bg-color: #000000;\n    --overlay-color: #f7f7f7;\n    --overlay-opacity: 0;\n  }\n\n  *{ box-sizing:border-box; }\n\n  body{\n    margin:0;\n    font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif;\n    background:#0d0c00;\n  }\n\n  .gallery10{\n    position:relative;\n    padding:32px 0 0;\n    background-image:none;\n    background-color: #000000;\n    background-size:cover;\n    background-position:center;\n    overflow:hidden;\n  }\n\n  .mbr-overlay{\n    position:absolute;\n    inset:0;\n    background-color: var(--overlay-color);\n    opacity: var(--overlay-opacity);\n    pointer-events:none;\n  }\n\n  .container-fluid{\n    position:relative;\n    z-index:1;\n    width:100%;\n  }\n\n  /* ---------- Ticker ---------- */\n  .ticker-viewport{\n    position:relative;\n    width:100%;\n    overflow:hidden;\n    padding:28px 0;\n    cursor:pointer;\n  }\n\n  .ticker-track{\n    display:flex;\n    width:max-content;\n    /* Slowed down further: longer duration = slower, easier-to-read scroll */\n    animation: ticker-scroll 180s linear infinite;\n    will-change: transform;\n  }\n\n  /* Pause completely on hover / mouse over — resumes on mouse out */\n  .ticker-viewport:hover .ticker-track,\n  .ticker-viewport:focus-within .ticker-track{\n    animation-play-state: paused;\n  }\n\n  .ticker-copy{\n    display:flex;\n    align-items:center;\n    white-space:nowrap;\n    padding-right:60px; /* gap before the loop repeats */\n  }\n\n  .ticker-copy span.piece{\n    color: var(--content-color);\n    font-weight:600;\n    /* +20pt over the previous 1.1rem (~17.6px) size ≈ 44.3px */\n    font-size:40.3px;\n    letter-spacing:0.01em;\n  }\n\n  .ticker-copy span.sep{\n    display:inline-block;\n    margin:0 20px;\n    opacity:0.5;\n    font-size:22.3px;\n    color: var(--content-color);\n  }\n\n  @keyframes ticker-scroll{\n    from{ transform: translateX(0); }\n    to{ transform: translateX(-50%); }\n  }\n\n  @media (prefers-reduced-motion: reduce){\n    .ticker-track{ animation-duration: 240s; }\n  }\n\n  /* Small hint so users know it's interactive */\n  .ticker-hint{\n    text-align:center;\n    font-size:11px;\n    letter-spacing:0.08em;\n    color: #e0342a;\n    font-weight:700;\n    opacity:1;\n    padding-bottom:6px;\n    position:relative;\n    z-index:1;\n  }\n\n  /* ---------- Edit trigger ---------- */\n  .edit-row{\n    text-align:center;\n    padding-bottom:14px;\n    position:relative;\n    z-index:1;\n  }\n  .edit-trigger{\n    background:none;\n    border:1px solid rgba(255,255,255,0.25);\n    color:rgba(255,255,255,0.75);\n    font-size:10px;\n    letter-spacing:0.06em;\n    text-transform:uppercase;\n    padding:5px 10px;\n    border-radius:6px;\n    cursor:pointer;\n  }\n  .edit-trigger:hover{ border-color:#fff; color:#fff; }\n\n  /* ---------- Modal / overlay shared ---------- */\n  .modal-mask{\n    position:fixed; inset:0;\n    background:rgba(0,0,0,0.72);\n    display:none;\n    align-items:center;\n    justify-content:center;\n    z-index:50;\n    padding:16px;\n  }\n  .modal-mask.open{ display:flex; }\n\n  .modal-box{\n    width:100%;\n    max-width:380px;\n    background:#111;\n    border:1px solid rgba(255,255,255,0.12);\n    border-radius:12px;\n    padding:22px 20px;\n    color:#fff;\n    font-family:inherit;\n  }\n  .modal-box h2{\n    font-size:15px;\n    letter-spacing:0.03em;\n    margin-bottom:4px;\n  }\n  .modal-box p.hint{\n    font-size:12px;\n    color:rgba(255,255,255,0.5);\n    margin-bottom:14px;\n  }\n  .modal-box input[type=\"password\"]{\n    width:100%;\n    background:#000;\n    border:1px solid rgba(255,255,255,0.2);\n    color:#fff;\n    font-size:16px;\n    letter-spacing:0.3em;\n    text-align:center;\n    padding:10px;\n    border-radius:8px;\n    outline:none;\n  }\n  .modal-box input[type=\"password\"]:focus{ border-color:#907401; }\n  .modal-error{\n    color:#e0554a;\n    font-size:12px;\n    min-height:16px;\n    margin-top:8px;\n  }\n  .modal-actions{\n    display:flex;\n    gap:10px;\n    margin-top:16px;\n  }\n  .modal-actions button{\n    flex:1;\n    padding:9px 0;\n    border-radius:7px;\n    border:none;\n    cursor:pointer;\n    font-size:12px;\n    letter-spacing:0.03em;\n  }\n  .btn-primary{ background:#907401; color:#fff; }\n  .btn-primary:hover{ background:#a9880a; }\n  .btn-secondary{ background:transparent; border:1px solid rgba(255,255,255,0.2) !important; color:#fff; }\n  .btn-secondary:hover{ border-color:#fff !important; }\n\n  /* ---------- Editor panel ---------- */\n  .editor-box{\n    width:100%;\n    max-width:560px;\n    max-height:65vh;\n    overflow-y:auto;\n  }\n  .editor-box textarea{\n    width:100%;\n    min-height:140px;\n    background:#000;\n    border:1px solid rgba(255,255,255,0.2);\n    color:#fff;\n    font-size:14px;\n    line-height:1.5;\n    padding:10px;\n    border-radius:8px;\n    outline:none;\n    resize:vertical;\n    font-family:inherit;\n    margin-top:10px;\n  }\n  .editor-box textarea:focus{ border-color:#907401; }\n\n  .style-controls{\n    display:flex;\n    flex-wrap:wrap;\n    gap:8px;\n    margin-top:14px;\n    align-items:center;\n  }\n  .style-controls button{\n    background:transparent;\n    border:1px solid rgba(255,255,255,0.25);\n    color:#fff;\n    font-size:12px;\n    padding:7px 12px;\n    border-radius:7px;\n    cursor:pointer;\n  }\n  .style-controls button:hover{ border-color:#907401; color:#907401; }\n  .style-controls button.active{\n    background:#907401;\n    border-color:#907401;\n    color:#fff;\n  }\n  .size-readout, .speed-readout{\n    font-size:11px;\n    color:rgba(255,255,255,0.5);\n    align-self:center;\n    margin-left:4px;\n  }\n\n  /* ---------- Control groups (speed + color) ---------- */\n  .control-group{\n    margin-top:16px;\n  }\n  .control-group .group-label{\n    display:block;\n    font-size:10px;\n    letter-spacing:0.08em;\n    text-transform:uppercase;\n    color:rgba(255,255,255,0.45);\n    margin-bottom:8px;\n  }\n\n  .color-row{\n    display:flex;\n    align-items:center;\n    gap:10px;\n    margin-top:16px;\n  }\n  .color-row input[type=\"color\"]{\n    -webkit-appearance:none;\n    appearance:none;\n    width:38px;\n    height:34px;\n    border:1px solid rgba(255,255,255,0.25);\n    border-radius:7px;\n    background:none;\n    padding:0;\n    cursor:pointer;\n  }\n  .color-row input[type=\"color\"]::-webkit-color-swatch-wrapper{ padding:2px; }\n  .color-row input[type=\"color\"]::-webkit-color-swatch{ border:none; border-radius:5px; }\n  .color-row .color-hex{\n    font-size:12px;\n    color:rgba(255,255,255,0.6);\n    letter-spacing:0.02em;\n  }\n</style>\n\n\n\n<section data-bs-version=\"5.1\" class=\"gallery10\">\n  <div class=\"mbr-overlay\"></div>\n\n  <div class=\"container-fluid\">\n    <div class=\"ticker-viewport\" id=\"tickerViewport\" tabindex=\"0\" aria-label=\"Beejay Mast Construction Company introduction, hover to pause\">\n      <div class=\"ticker-track\" id=\"tickerTrack\">\n        <div class=\"ticker-copy\" id=\"copyA\"></div>\n        <div class=\"ticker-copy\" id=\"copyB\" aria-hidden=\"true\"></div>\n      </div>\n    </div>\n    <div class=\"ticker-hint\">Hover To Pause &amp; Read Live Messaging</div>\n    <div class=\"edit-row\">\n      <button type=\"button\" class=\"edit-trigger\" id=\"editTrigger\">✎ Edit ticker</button>\n    </div>\n  </div>\n</section>\n\n<!-- Passcode gate -->\n<div class=\"modal-mask\" id=\"passMask\">\n  <div class=\"modal-box\">\n    <h2>Enter access passcode</h2>\n    <p class=\"hint\">Required to edit or correct the scrolling text.</p>\n    <input type=\"password\" id=\"passInput\" inputmode=\"numeric\" maxlength=\"12\" placeholder=\"••••••\" autocomplete=\"off\">\n    <div class=\"modal-error\" id=\"passError\"></div>\n    <div class=\"modal-actions\">\n      <button type=\"button\" class=\"btn-secondary\" id=\"passCancel\">Cancel</button>\n      <button type=\"button\" class=\"btn-primary\" id=\"passSubmit\">Unlock</button>\n    </div>\n  </div>\n</div>\n\n<!-- Live editor -->\n<div class=\"modal-mask\" id=\"editorMask\">\n  <div class=\"modal-box editor-box\">\n    <h2>Edit scrolling text</h2>\n    <p class=\"hint\">Changes apply immediately to the ticker on this page.</p>\n    <textarea id=\"editorText\" placeholder=\"Type the new ticker message here…\"></textarea>\n\n    <div class=\"control-group\">\n      <span class=\"group-label\">Font</span>\n      <div class=\"style-controls\">\n        <button type=\"button\" id=\"btnBold\">Bold</button>\n        <button type=\"button\" id=\"btnNormal\">Normal</button>\n        <button type=\"button\" id=\"btnSizeDown\">A−</button>\n        <button type=\"button\" id=\"btnSizeUp\">A+</button>\n        <span class=\"size-readout\" id=\"sizeReadout\"></span>\n      </div>\n    </div>\n\n    <div class=\"control-group\">\n      <span class=\"group-label\">Scroll speed</span>\n      <div class=\"style-controls\">\n        <button type=\"button\" id=\"btnSpeedDown\">Speed −</button>\n        <button type=\"button\" id=\"btnSpeedUp\">Speed +</button>\n        <span class=\"speed-readout\" id=\"speedReadout\"></span>\n      </div>\n    </div>\n\n    <div class=\"control-group\">\n      <span class=\"group-label\">Text color</span>\n      <div class=\"color-row\">\n        <input type=\"color\" id=\"colorPicker\" value=\"#907401\">\n        <span class=\"color-hex\" id=\"colorHex\">#907401</span>\n      </div>\n    </div>\n\n    <div class=\"modal-actions\">\n      <button type=\"button\" class=\"btn-secondary\" id=\"editorCancel\">Cancel</button>\n      <button type=\"button\" class=\"btn-primary\" id=\"editorApply\">Apply</button>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  // ===== EDIT ONLY THIS: the scrolling message content =====\n  let LINE = \"🌍CCDI Brief Introduction:- 🎯Welcome to the 🎨Creative Craft Development Initiative - CCDI, 🏛️OPERATES THROUGH A FOUR-INTEGRATED-ARM STRUCTURE, 🎥SOCIAL ENTERPRISE ARM, 🌐YOUNG ENTREPRENEURS INITIATIVE ARM, 🛡️CREATIVE COMMUNITY INITIATIVE ARM, 🎓Institutional Backing, 🎙️The Broadcast Arm of a Growing Media Powerhouse, 📺CCDI - We believe everyone has the ability to 🖥learn and master, 🛠️a skill given proper support and training. 🔗One Network, 📢One Standard of Excellence, 🚀Built to Scale, 🌟Powered to Lead\";\n  // ===========================================================\n\n  function buildCopy(container){\n    const pieces = LINE.split(',').map(s => s.trim()).filter(Boolean);\n    container.innerHTML = pieces\n      .map(p => `<span class=\"piece\">${p}</span>`)\n      .join('<span class=\"sep\">•</span>');\n  }\n\n  buildCopy(document.getElementById('copyA'));\n  buildCopy(document.getElementById('copyB'));\n\n  // Extra safety net: also pause/resume via JS for touch devices\n  // that don't reliably support :hover (tap to pause / tap again to resume).\n  const viewport = document.getElementById('tickerViewport');\n  const track = document.getElementById('tickerTrack');\n  let paused = false;\n\n  viewport.addEventListener('click', function(){\n    paused = !paused;\n    track.style.animationPlayState = paused ? 'paused' : 'running';\n  });\n\n  viewport.addEventListener('mouseenter', function(){\n    track.style.animationPlayState = 'paused';\n  });\n  viewport.addEventListener('mouseleave', function(){\n    if (!paused) track.style.animationPlayState = 'running';\n  });\n\n  /* =====================================================================\n     LIVE EDITOR — passcode gated\n     The access code is never stored in the page as readable text. It is\n     kept only as a SHA-256 hash; on entry, the typed code is hashed the\n     same way in the browser and the two hashes are compared. Anyone\n     reading the source sees only the hash below, not the code itself.\n     Note (please be aware): this stops casual view-source snooping, but\n     it is still front-end only — a determined person could brute-force\n     a 6-digit numeric code offline against the hash. For real protection\n     (multiple editors, shared/broadcast updates, stronger auth) this\n     needs a small server-side check.\n     ===================================================================== */\n  const PASSCODE_HASH = \"e121c851cf749d24e7ee1047e9e8ea8fe6c4d9273909530f1814396be9e3b1c9\";\n\n  async function sha256Hex(text){\n    const enc = new TextEncoder().encode(text);\n    const digest = await crypto.subtle.digest('SHA-256', enc);\n    return Array.from(new Uint8Array(digest))\n      .map(b => b.toString(16).padStart(2, '0'))\n      .join('');\n  }\n\n  const editTrigger = document.getElementById('editTrigger');\n  const passMask = document.getElementById('passMask');\n  const passInput = document.getElementById('passInput');\n  const passError = document.getElementById('passError');\n  const passSubmit = document.getElementById('passSubmit');\n  const passCancel = document.getElementById('passCancel');\n\n  const editorMask = document.getElementById('editorMask');\n  const editorText = document.getElementById('editorText');\n  const editorApply = document.getElementById('editorApply');\n  const editorCancel = document.getElementById('editorCancel');\n  const btnBold = document.getElementById('btnBold');\n  const btnNormal = document.getElementById('btnNormal');\n  const btnSizeUp = document.getElementById('btnSizeUp');\n  const btnSizeDown = document.getElementById('btnSizeDown');\n  const sizeReadout = document.getElementById('sizeReadout');\n  const btnSpeedUp = document.getElementById('btnSpeedUp');\n  const btnSpeedDown = document.getElementById('btnSpeedDown');\n  const speedReadout = document.getElementById('speedReadout');\n  const colorPicker = document.getElementById('colorPicker');\n  const colorHex = document.getElementById('colorHex');\n\n  let pendingWeight = 600;   // matches current default font-weight\n  let pendingSize = 44.3;    // matches current default font-size (px)\n  let pendingSpeed = 180;    // matches current default animation duration (seconds per loop)\n  let pendingColor = '#907401'; // matches current default --content-color\n  const MIN_SIZE = 14, MAX_SIZE = 96;\n  // Lower duration = faster scroll, higher duration = slower scroll.\n  const MIN_SPEED = 30, MAX_SPEED = 320, SPEED_STEP = 20;\n\n  function openPassGate(){\n    passInput.value = '';\n    passError.textContent = '';\n    passMask.classList.add('open');\n    setTimeout(()=> passInput.focus(), 30);\n  }\n  function closePassGate(){ passMask.classList.remove('open'); }\n\n  function openEditor(){\n    editorText.value = LINE;\n    updateSizeReadout();\n    updateSpeedReadout();\n    colorPicker.value = pendingColor;\n    colorHex.textContent = pendingColor;\n    syncStyleButtons();\n    editorMask.classList.add('open');\n    setTimeout(()=> editorText.focus(), 30);\n  }\n  function closeEditor(){ editorMask.classList.remove('open'); }\n\n  function updateSizeReadout(){\n    sizeReadout.textContent = Math.round(pendingSize) + 'px';\n  }\n  function updateSpeedReadout(){\n    // Show a plain-language speed label alongside the raw duration so it\n    // reads clearly even without knowing what \"seconds per loop\" means.\n    let label;\n    if (pendingSpeed <= 70) label = 'Fast';\n    else if (pendingSpeed <= 140) label = 'Medium';\n    else if (pendingSpeed <= 220) label = 'Slow';\n    else label = 'Very slow';\n    speedReadout.textContent = label + ' (' + Math.round(pendingSpeed) + 's/loop)';\n  }\n  function syncStyleButtons(){\n    btnBold.classList.toggle('active', pendingWeight >= 700);\n    btnNormal.classList.toggle('active', pendingWeight < 700);\n  }\n\n  editTrigger.addEventListener('click', openPassGate);\n  passCancel.addEventListener('click', closePassGate);\n  passMask.addEventListener('click', function(e){ if (e.target === passMask) closePassGate(); });\n\n  async function attemptUnlock(){\n    const typed = passInput.value.trim();\n    if (!typed){ passError.textContent = 'Enter the passcode.'; return; }\n    passSubmit.disabled = true;\n    try{\n      const hash = await sha256Hex(typed);\n      if (hash === PASSCODE_HASH){\n        closePassGate();\n        openEditor();\n      } else {\n        passError.textContent = 'Incorrect passcode.';\n        passInput.value = '';\n        passInput.focus();\n      }\n    } finally {\n      passSubmit.disabled = false;\n    }\n  }\n\n  passSubmit.addEventListener('click', attemptUnlock);\n  passInput.addEventListener('keydown', function(e){ if (e.key === 'Enter') attemptUnlock(); });\n\n  editorCancel.addEventListener('click', closeEditor);\n  editorMask.addEventListener('click', function(e){ if (e.target === editorMask) closeEditor(); });\n\n  btnBold.addEventListener('click', function(){ pendingWeight = 700; syncStyleButtons(); });\n  btnNormal.addEventListener('click', function(){ pendingWeight = 400; syncStyleButtons(); });\n  btnSizeUp.addEventListener('click', function(){\n    pendingSize = Math.min(MAX_SIZE, pendingSize + 4);\n    updateSizeReadout();\n  });\n  btnSizeDown.addEventListener('click', function(){\n    pendingSize = Math.max(MIN_SIZE, pendingSize - 4);\n    updateSizeReadout();\n  });\n\n  // \"+\" makes it scroll faster (shorter duration); \"−\" makes it scroll\n  // slower (longer duration) — matches how a volume/speed \"+/-\" control\n  // usually behaves, even though the underlying CSS value moves opposite.\n  btnSpeedUp.addEventListener('click', function(){\n    pendingSpeed = Math.max(MIN_SPEED, pendingSpeed - SPEED_STEP);\n    updateSpeedReadout();\n  });\n  btnSpeedDown.addEventListener('click', function(){\n    pendingSpeed = Math.min(MAX_SPEED, pendingSpeed + SPEED_STEP);\n    updateSpeedReadout();\n  });\n\n  colorPicker.addEventListener('input', function(){\n    pendingColor = colorPicker.value;\n    colorHex.textContent = pendingColor;\n  });\n\n  editorApply.addEventListener('click', function(){\n    const newText = editorText.value.trim();\n    if (!newText) return;\n\n    LINE = newText;\n\n    buildCopy(document.getElementById('copyA'));\n    buildCopy(document.getElementById('copyB'));\n    document.querySelectorAll('.ticker-copy span.piece, .ticker-copy span.sep').forEach(el=>{\n      el.style.fontWeight = pendingWeight;\n      el.style.fontSize = pendingSize + 'px';\n      el.style.color = pendingColor;\n    });\n\n    track.style.animationDuration = pendingSpeed + 's';\n\n    closeEditor();\n  });\n})();\n</script>\n\n\n",
          "_anchor": "gallery10-2g",
