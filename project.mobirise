      "settings": {
        "main": true,
        "title": "CCDI HOME -  The Creative Craft Development Initiative (CCDI)",
        "meta_descr": "ABOUT CCDI\nIntroduction\n🌟 Creative Craft Development Initiative - CCDI; We believe everyone has the ability to learn and master a skill when given proper support, training, and opportunity.\nFor over 18 years, we have impacted more than 3,000 beneficiaries annually through vocational training, empowerment programs, child welfare initiatives, and sustainable community development.\n\nOur organization exists to bridge the gap between potentials and skills in people through self-discovery, self-mastery, and practical life empowerment.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "socialSharingUrl": ""
