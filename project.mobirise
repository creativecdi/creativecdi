                "&:before": {
                  "content": "\"@{line1}\""
                }
              },
              ".line-active": {
                "width": "~\"@{line1}%\""
              }
            },
            ".line-item-2": {
              ".line-number": {
                "&:before": {
                  "content": "\"@{line2}\""
                }
