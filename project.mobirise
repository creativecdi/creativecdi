                "align-items": "flex-start",
                "li": {
                  "margin": "0 !important"
                },
                ".nav-link": {
                  "width": "max-content !important",
                  "max-width": "100% !important",
                  "margin": "5px 0 !important"
                }
              },
              ".navbar .navbar-collapse .dropdown .dropdown-menu": {
