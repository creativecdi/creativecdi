                      "top": "10px",
                      "opacity": "0",
                      "transition": "all 0.3s"
                    },
                    "&:nth-child(2)": {
                      "top": "10px",
                      "transition": "all 0.25s",
                      "opacity": "1"
                    },
                    "&:nth-child(3)": {
                      "top": "10px",
                      "opacity": "1",
                      "transition": "all 0.25s"
                    },
                    "&:nth-child(4)": {
                      "top": "10px",
                      "opacity": "0",
                      "transition": "all 0.3s"
                    }
                  }
                }
              }
