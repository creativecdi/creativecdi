        {
          "_name": "people02",
          "_sourceTheme": "beatm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\" beatm5 people2\" group=\"People\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"8\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"8\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Color</header>\n        <input type=\"color\" title=\"Card BG\" name=\"row\" value=\"#232323\" selected>\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#232323\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n\n            <div class=\"col-12 col-md-12 col-lg-6\">\n                <div class=\"text-wrapper align-left\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style mb-5 pb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>TAKE ACTION</b></h1>\n                    <p class=\"mbr-text mbr-fonts-style pb-5 mb-5\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><b><i>\"Sowing Seeds of Hope: Rock Messengers <br>Outreach Initiatives for Feeding Needy Children\"</i><br></b><br>Here are some ideas suggested for Rock Messengers Outreach to feed children of the needy despite limited resources:\n<br>\n<br>1. Partner with local food banks or organizations.\n<br>2. Organize food drives or fundraising campaigns.\n<br>3. Seek donations from individuals or businesses.\n<br>4. Prepare and distribute nutritious meals or snacks.\n<br>5. Collaborate with agencies/ centers for meal programs.\n<br>6. Provide food vouchers or gift cards to families.\n<br>7. Support sustainable food projects, like community gardens.\n<br>8. Apply for grants or funding from foundations programs.\n<br>9. Engage volunteers to help with food preparation.\n<br>10. Pray and seek divine provision and guidance.\n<br>\n<br>Remember, even small efforts can make a significant impact when done with love and compassion!<br><br>Host community outreach programs, such as health fairs, education drives, or environmental initiatives<br></p>\n                    <div mbr-buttons mbr-theme-style=\"display-2\" class=\"mbr-section-btn mt-5 pt-4\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-warning-outline\" href=\"account.html#donation2Support44\" data-app-placeholder=\"Type Text\">Kindly Donate to our&nbsp; Activities</a></div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-12 col-lg-6 p-0 image-wrapper\">\n                <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/002-1600x900.jpg\" alt=\"GIVEN - FEED THE HUNGRY\">\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".text-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "2rem"
              }
            },
            ".row": {
              "background": "@row",
              "align-items": "center",
              "padding": "3rem",
              "border-radius": "3rem",
              "width": "fit-content",
              "max-width": "1100px",
              "margin": "auto",
              "@media (max-width: 767px)": {
                "padding": "3rem 1rem",
                "padding-bottom": "1rem",
                "border-radius": "2rem"
              }
            },
            "img": {
              "border-radius": "3rem",
              "@media (max-width: 767px)": {
                "border-radius": "2rem"
              }
            },
            ".image-wrapper": {
              "@media (max-width: 991px)": {
                "padding": "1rem"
              }
            },
            ".mbr-section-title": {
              "color": "#e2c61c"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
