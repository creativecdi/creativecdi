            ".mbr-iconfont": {
              "position": "relative",
              "font-size": "13px !important",
              "font-family": "'Moririse2' !important",
              "color": "@iconColor",
              "margin-left": "1rem",
              "padding": "7px",
              "transition": ".2s all",
              "&:after": {
                "content": "\"\"",
                "position": "absolute",
                "top": "50%",
                "left": "50%",
                "transform": "translate(-50%, -50%)",
                "width": "100%",
                "height": "100%",
                "border-radius": "50%",
                "background-color": "spin(saturate(lighten(@iconColor, 30%), 30%), 10)",
                "opacity": "1",
                "transition": ".2s all"
              },
              "&:before": {
                "position": "relative",
                "z-index": "2"
              }
            },
            ".panel-group": {
              "border": "none"
            },
            ".card": {
              "border-radius": "0",
              "&:not(:first-child)": {
                "margin-top": "12px",
                "border-top": "2px solid @borderColor"
              }
            },
            ".card-header": {
              "padding": "0",
              "border": "none",
              "background-color": "transparent",
              "margin-bottom": "0",
              "&:hover": {
                ".mbr-iconfont": {
                  "transform": "rotate(180deg)"
                }
