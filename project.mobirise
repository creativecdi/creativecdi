            "form": {
              "width": "100%",
              ".dragArea.row": {
                "justify-content": "flex-start",
                "width": "auto !important",
                "z-index": "2"
              },
              "p": {
                "color": "#353535"
              },
              ".form-group": {
                "margin-top": "0 !important",
                "margin-bottom": "18px !important"
              },
