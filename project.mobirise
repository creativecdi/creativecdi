        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "overflow": "hidden",
            ".mbr-section-title": {
              "color": "#b8aa4f",
              "& when (@fullWidth)": {
                "display": "flex",
                "justify-content": "center",
                "white-space": "nowrap",
                "&.display-1": {
                  "font-size": "200px !important",
                  "line-height": "1 !important",
                  "@media (max-width: 991px)": {
                    "font-size": "130px !important"
                  },
                  "@media (max-width: 767px)": {
                    "font-size": "100px !important"
                  }
                }
              }
            },
            ".mbr-section-subtitle": {
              "color": "#303030"
            }
          },
          "_name": "aarticle1",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article1 charitym5\" group=\"Content\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" step=\"1\" value=\"12\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#453c04\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFE2DA\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"title col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\"><i style>Discovering and Empowering Special Talents Amongst the Less Privileged from the Slums.</i></h3>\n                <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-0 mt-3\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\">\n                    Molestie a iaculis at erat pellentesque.\n                </h4>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "ul3dgERJVa",
          "_anchor": "aarticle1-1q",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "overflow": "hidden",
            ".row": {
              "margin-left": "-30px",
              "margin-right": "-30px",
              "justify-content": "center",
              "row-gap": "60px",
              "> [class*=\"col\"]": {
                "padding-left": "30px",
                "padding-right": "30px"
              },
              "@media (max-width: 991px)": {
                "row-gap": "40px"
              }
            },
            ".mbr-section-head": {
              "padding-bottom": "50px"
            },
            ".mbr-section-title": {
              "color": "#9b8db7"
            },
            ".mbr-section-subtitle": {
              "color": "#303030",
              "margin-top": "16px"
            },
            ".item-img": {
              "position": "relative",
              "width": "100%",
              "overflow": "hidden",
              "img": {
                "width": "100%",
                "aspect-ratio": "~\"calc(131 / (59 * @{imgHeight}))\"",
                "object-fit": "cover",
                "transform": "scale(1.01)",
                "transition": "all .5s ease"
              }
            },
            ".mbr-section-btn": {
              "position": "absolute",
              "top": "100%",
              "left": "0",
              "display": "flex",
              "justify-content": "center",
              "width": "100%",
              "transition": "all .5s ease",
              "margin": "0 !important",
              "@media (max-width: 575px)": {
                "transform": "translateY(-100%)"
              },
              ".btn": {
                "width": "100%",
                "margin": "0 !important",
                "padding": "10px 34px 10px !important",
                "&:after": {
                  "bottom": "11px !important",
                  "width": "50% !important"
                }
              }
            },
            ".item-wrapper": {
              "width": "100%",
              "height": "100%",
              "padding": "0",
              "transition": ".3s all",
              "&:hover": {
                ".item-img": {
                  "img": {
                    "transform": "scale(1.05)"
                  }
                },
                ".mbr-section-btn": {
                  "transform": "translateY(-100%)"
                }
              },
              "@media (max-width: 767px)": {}
            },
            ".item-content": {
              "margin-top": "32px"
            },
            ".item-title": {
              "color": "#6b366f"
            },
            ".mbr-text": {
              "margin-top": "11px",
              "color": "#303030"
            },
            ".item-number": {
              "color": "#003a03",
              "margin-top": "22px"
            },
            ".item-border": {
              "width": "100%",
              "height": "4px",
              "margin-top": "3px",
              "border-radius": "5px",
              "background-color": "@borderColor"
            },
            ".item-text-wrap": {
              "display": "flex",
              "align-items": "flex-start",
              "justify-content": "flex-start",
              "gap": "30px",
              "margin-top": "16px"
            },
            ".item-text": {
              "color": "#000000"
            }
          },
          "_name": "agallery3",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery3 charitym5\" group=\"Sliders & Galleries\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n        <header>Cards</header>\n        <input type=\"range\" inline title=\"Image Height\" name=\"imgHeight\" min=\"1\" max=\"5\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Button\" checked>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n        <input type=\"checkbox\" name=\"showNumber\" title=\"Number\" checked>\n        <input type=\"checkbox\" name=\"showBorder\" title=\"Border\" checked>\n        <input type=\"color\" name=\"borderColor\" title=\"Border Color\" value=\"#77ca0d\" condition=\"showBorder\">\n        <input type=\"checkbox\" name=\"showInfo\" title=\"Info\" checked>\n        <input type=\"range\" inline title=\"Info Count\" name=\"infoCount\" min=\"1\" max=\"2\" step=\"1\" value=\"2\" condition=\"showInfo\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#FFFFFF\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div class=\"container\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                <b>DIAM DONEC ADIPISCING</b>\n            </h4>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                Volutpat ac tincidunt vitae semper quis lectus nulla at volutpat.\n            </h5>\n        </div>\n        <div class=\"row items-row {{contentAlign}}\">\n            <div class=\"item features-image col-12 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/rockmessengers-hospital-visitation.png\" alt=\"Mobirise Website Builder\">\n                        <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"account.html#donation2Support44\" class=\"btn item-btn btn-black\" target=\"_blank\" data-app-placeholder=\"Type Text\">PLEASE DONATE</a></div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showInfo || showText || showBorder\">\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            <b>Hospital Visitation</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                            One-on-one support, mind and spirit. We provide financial assistance, prayerful support, and emotional comfort to patients at every hospitals we visit to pray, give cash, bringing <br>hope in times of need.\n                        </p>\n                        <h5 class=\"item-number mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" data-app-selector=\".item-number\" mbr-if=\"showNumber\"><b>2.0%</b>\n                        </h5>\n                        <div class=\"item-border\" mbr-if=\"showBorder\"></div>\n                        <div class=\"item-text-wrap\" mbr-if=\"showInfo\">\n                            <p class=\"item-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                               Raised: 000,000.00₦</p>\n                            <p class=\"item-text mbr-fonts-style mb-0\" mbr-if=\"infoCount > 1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\"><b>\n                                Goal: ₦100M</b></p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mama.png\" alt=\"Mobirise Website Builder\">\n                        <div class=\"mbr-section-btn item-footer \" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"account.html#donation2Support44\" class=\"btn item-btn btn-black\" target=\"_blank\" data-app-placeholder=\"Type Text\">PLEASE DONATE&nbsp;</a></div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showInfo || showText || showBorder\">\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>Touching Hearts, Changing Lives</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                            Rock Messengers shares wisdom and care, supporting those in rehabilitation, trauma, and need. We help settle medical bills, empower widows and children, and provide hope and guidance to overcome adversity\n                        </p>\n                        <h5 class=\"item-number mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" data-app-selector=\".item-number\" mbr-if=\"showNumber\"><b>3.0%</b>\n                        </h5>\n                        <div class=\"item-border\" mbr-if=\"showBorder\"></div>\n                        <div class=\"item-text-wrap\" mbr-if=\"showInfo\">\n                            <p class=\"item-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                Raised: 000,000.00₦\n                            </p>\n                            <p class=\"item-text mbr-fonts-style mb-0\" mbr-if=\"infoCount > 1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\"><b>Goal: ₦100M</b></p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/put-smiles-on-their-faces.png\" alt=\"Mobirise Website Builder\">\n                        <div class=\"mbr-section-btn item-footer \" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"account.html#donation2Support44\" class=\"btn item-btn btn-black\" target=\"_blank\" data-app-placeholder=\"Type Text\">PLEASE DONATE&nbsp;</a></div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showInfo || showText || showBorder\">\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>Give Hope, Give Love</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Offer nutritious food and healthcare to nourish their bodies.&nbsp;Listen and counsel to heal emotional scars and bring hope.<br>Teach life skills and confidence to help them thrive. Show love, kindness, and compassion to fill their hearts.</p>\n                        <h5 class=\"item-number mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" data-app-selector=\".item-number\" mbr-if=\"showNumber\">\n                            <b>5.0%</b>\n                        </h5>\n                        <div class=\"item-border\" mbr-if=\"showBorder\"></div>\n                        <div class=\"item-text-wrap\" mbr-if=\"showInfo\">\n                            <p class=\"item-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Raised: 000,000.00₦\n                            </p>\n                            <p class=\"item-text mbr-fonts-style mb-0\" mbr-if=\"infoCount > 1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\"><b>\n                                Goal: ₦100M\n                            </b></p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "ul3dgFrrPT",
          "_anchor": "agallery3-1r",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
