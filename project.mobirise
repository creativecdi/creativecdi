                "background-image": "url(@fallBackImage)"
              }
            },
            ".cards-row": {
              "row-gap": "50px"
            },
            ".card-wrapper": {
              "display": "flex",
              "align-items": "flex-start"
            },
            ".number-text": {
              "color": "#058a3b",
              "margin-right": "36px",
              "word-break": "normal",
              "max-width": "50%"
            },
            ".card-box": {
              "padding-top": "4px"
            },
            ".card-title": {
              "color": "#303030"
            },
            ".card-text": {
              "color": "#303030",
              "margin-top": "15px"
            },
            ".mbr-section-btn": {
              "margin-top": "7px"
            }
