                "min-width": "auto",
                "max-width": "100%"
              }
            },
            "& when (@collapsed)": {
              ".container, .container-fluid": {
                "flex-wrap": "wrap"
              },
              ".navbar-brand": {
                "width": "auto",
                "min-height": "98px"
              },
