          "_name": "aheader1",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header1 charitym5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"12\" step=\"1\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/pexels-rodnae-productions-6647021-1920x1280.jpg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#FFFFFF\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <h1 class=\"mbr-section-title mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b><br></b><br><b>Social Welfare Donor's<br>Financial Support</b></h1>\n                <h2 class=\"mbr-section-subtitle mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\">\n                    Nunc faucibus a pellentesque sit amet porttitor eget dolor.\n                </h2>\n                <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">collaborative funding partnerships to deliver critical financial support to <br>vulnerable groups of the society with donations made through partnership/support</p>\n                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-black\" href=\"contact.html#aform2-1k\" data-app-placeholder=\"Type Text\">\n                        BECOME A VOLUNTEER\n                    </a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "ukzU975oNV",
          "_anchor": "aheader1-14",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-head": {
              "width": "100%",
              "margin-bottom": "30px"
            },
            ".mbr-section-title": {
              "color": "#64480b",
              "margin-bottom": "0"
            },
            ".mbr-section-subtitle": {
              "color": "#1c2a1b",
              "margin-top": "16px"
            },
            ".mbr-iconfont": {
              "position": "relative",
              "font-size": "13px !important",
              "font-family": "'Moririse2' !important",
              "color": "@iconColor",
              "margin-left": "1rem",
              "padding": "7px",
              "transition": ".2s all",
              "&:after": {
                "content": "\"\"",
                "position": "absolute",
                "top": "50%",
                "left": "50%",
                "transform": "translate(-50%, -50%)",
                "width": "100%",
                "height": "100%",
                "border-radius": "50%",
                "background-color": "spin(saturate(lighten(@iconColor, 30%), 30%), 10)",
                "opacity": "1",
                "transition": ".2s all"
              },
              "&:before": {
                "position": "relative",
                "z-index": "2"
              }
            },
            ".panel-group": {
              "border": "none"
            },
            ".card": {
              "border-radius": "0",
              "&:not(:first-child)": {
                "margin-top": "12px",
                "border-top": "2px solid @borderColor"
              }
            },
            ".card-header": {
              "padding": "0",
              "border": "none",
              "background-color": "transparent",
              "margin-bottom": "0",
              "&:hover": {
                ".mbr-iconfont": {
                  "transform": "rotate(180deg)"
                }
              }
            },
            ".panel-title": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding": "12px 10px 20px 0",
              "color": "#303030",
              "transition": ".2s all",
              "&[aria-expanded=\"true\"]": {
                "padding": "12px 10px 13px 0",
                ".mbr-iconfont": {
                  "transform": "rotate(180deg)"
                }
              }
            },
            ".panel-title-edit": {
              "color": "#1a6001"
            },
            ".panel-body": {
              "padding": "0 0 30px"
            },
            ".panel-text": {
              "color": "#303030",
              "margin": "0"
            }
          },
          "_name": "alist1",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list1 charitym5\" group=\"List\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-switch-arrow, mobirise-icons2\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Width\" name=\"contentWidth\" min=\"6\" max=\"12\" step=\"1\" value=\"9\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#77ca0d\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#1a6001\">\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f0e8f8\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h3 class=\"mbr-section-title mb-0 mbr-fonts-style align-left\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" mbr-if=\"showTitle\"><b>Nonprofit Support Organization. <br>We Help Voluntarily</b></h3>\n            <h4 class=\"mbr-section-subtitle mb-0 mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-subtitle\" mbr-if=\"showSubtitle\"><b><i>Rock Messengers Outreach is a nonprofit organization driven by a divine vision to bring hope and comfort to vulnerable populations. Our mission is to address the spiritual and physical well-being of:\n<br></i></b><br><div>\n</div><div><b>-</b> <b>Inmates within correctional facilities\n</b></div><div><b>-</b> <b>Patients confined to hospital beds\n</b></div><div><b>-</b> <b>Individuals with disabilities in inclusive centers\n</b></div><div><b>-</b> <b>Those receiving rehabilitation support services</b></div><div><b>- Compassionate Support for Widows<br><br></b></div><div>We believe that nurturing both the soul and body is crucial for healing and transformation. Our dual approach includes:\n</div><div><b>- Spiritual guidance and support through the sharing of God's word\n</b></div><div><b>- Practical provision of essential daily needs like food and necessities\n</b></div><div><br>Our team is dedicated to imparting hope and purpose to those in need. For inmates, our message offers a beacon of light in dark times, fostering personal growth and rehabilitation. For hospital patients, we aim to alleviate burdens and enhance their physical and emotional well-being.&nbsp;</div><br><div><span style=\"font-size: 1.3rem;\">By embracing a holistic approach to ministry, we're committed to making a positive impact in the lives of those we serve. Join us in this noble endeavor as we strive to fulfill our divine calling with dedication and compassion.&nbsp;</span><span style=\"font-size: 1.3rem;\">Due to limited funds, our monthly visits have been reduced to once every three months. We invite you to partner with us to continue this vital work.<br><br></span></div><div>\n</div><div>Contact: <br><b>David Nwaorah</b> <b>|</b> <b>08059423380</b></div><div>\n</div><div>\n</div><div>\n</div><div>\n</div><div>\n</div><div>\n</div></h4>\n        </div>\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-lg-{{contentWidth}}\">\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                    <div class=\"card\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>1. - Inmates within correctional facilities</b></h6>\n                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-up\"></span>\n                            </a>\n                        </div>\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                    Rock Messengers Outreach provides spiritual guidance, emotional support, practical resources, and cash grants to support within correctional facilities, empowering them to transform their lives and reintegrate into society as reformed individuals.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 1\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>2. - Patients confined to hospital beds</b></h6>\n                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-up\"></span>\n                            </a>\n                        </div>\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                    We provide financial assistance to patients confined to hospital beds, easing their burden and allowing them to focus on recovery. By paying medical bills for those in need, we bring hope and relief to those who need it most\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 2\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>3. -&nbsp; Individuals with disabilities in inclusive centers</b></h6>\n                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-up\"></span>\n                            </a>\n                        </div>\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                    We can help individuals with disabilities by providing accessibility, support services, and resources, promoting inclusion and empowerment, and advocating for disability rights and awareness. We also donate collaboratively with donors givens.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 3\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>4. - Those receiving rehabilitation support services</b></h6>\n                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-up\"></span>\n                            </a>\n                        </div>\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                    We also support in group, people receiving rehabilitation services by providing emotional support, education, and practical assistance, helping them achieve their goals with the donations we receive on their behaves and improve their well-being by being absolute sincere. Additionally, connecting them with community resources, facilitating social connections, and celebrating their progress can further empower them on their journey to recovery.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 4\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">\n                                    <b>Facilisis mauris</b>\n                                </h6>\n                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-up\"></span>\n                            </a>\n                        </div>\n                        <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                    Id cursus metus aliquam eleifend mi in. Eu mi bibendum neque egestas\n                                    congue quisque egestas diam in. Condimentum vitae sapien pellentesque habitant morbi.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 5\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">\n                                    <b>Enim neque</b>\n                                </h6>\n                                <span class=\"sign mbr-iconfont mobi-mbri-arrow-up\"></span>\n                            </a>\n                        </div>\n                        <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                    Nullam ac tortor vitae purus faucibus ornare suspendisse.\n                                    Sollicitudin ac orci phasellus egestas tellus rutrum tellus pellentesque.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "ukzU97ErLa",
          "_anchor": "alist1-15",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "max-width": "100%"
            },
            ".row": {
              "margin-left": "0",
              "margin-right": "0",
              "justify-content": "center",
              "> [class*=\"col\"]": {
                "padding-left": "0",
                "padding-right": "0"
              }
            },
            ".main-row": {
              "& when (@reverseContent)": {
                "flex-direction": "row-reverse"
              }
            },
            ".col-img": {
              "@media (max-width: 991px)": {
                "order": "2"
              }
            },
            ".item-img": {
              "height": "100%",
              "width": "100%",
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover"
              }
            },
            ".content-wrap": {
              "display": "flex",
              "align-items": "flex-start",
              "width": "100%",
              "padding": "75px 100px 130px 80px",
              "& when not (@fullWidth)": {
                "padding": "65px 60px 100px 40px"
              },
              "@media (max-width: 1439px)": {
                "padding": "55px 50px 100px 50px",
                "& when not (@fullWidth)": {
                  "padding": "35px 40px 70px 30px"
                }
              },
              "@media (max-width: 991px)": {
                "padding": "75px 80px 70px 80px",
                "& when not (@fullWidth)": {
                  "padding": "65px 40px 50px 40px"
                }
              },
              "@media (max-width: 767px)": {
                "padding": "70px 25px 70px 25px",
                "& when not (@fullWidth)": {
                  "padding": "60px 2px 50px 2px"
                }
              }
            },
            ".icon-wrap": {
              "margin-right": "15px",
              ".mbr-iconfont": {
                "font-size": "32px",
                "color": "@iconColor"
              }
            },
            ".tabs-wrap": {
              "flex-grow": "1"
            },
            ".mbr-text": {
              "margin-bottom": "30px",
              "color": "#000000",
              "text-align": "center"
            },
            ".tabs-prof": {
              "color": "#303030",
              "text-decoration": "underline",
              "text-align": "center"
            },
            ".tabs-name": {
              "margin-top": "6px",
              "color": "#303030",
              "text-align": "center"
            },
            ".nav-tabs .nav-item.open .nav-link:focus, .nav-tabs .nav-link.active:focus": {
              "outline": "none"
            },
            ".nav-tabs": {
              "flex-wrap": "wrap",
              "margin-top": "40px",
              "border": "none !important"
            },
            ".nav-item": {
              "margin-right": "25px"
            },
            ".nav-link": {
              "position": "relative",
              "padding": "0",
              "margin-bottom": "20px",
              "transition": "all .5s",
              "border": "none",
              "border-radius": "0 !important",
              "&:not(.active)": {
                "color": "@tabsColor"
              },
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "left": "0",
                "bottom": "0",
                "height": "2px",
                "width": "100%",
                "background-color": "currentColor",
                "transform": "scaleX(0)",
                "transform-origin": "left",
                "transition": "transform 1s cubic-bezier(0.33, 0.52, 0.05, 0.96)"
              },
              "&:hover": {
                "&:before": {
                  "transform": "scaleX(1)"
                }
              }
            },
            ".nav-tabs .nav-link.active": {
              "color": "@activeColor",
              "background-color": "transparent !important",
              "&:before": {
                "transform": "scaleX(1)"
              }
            }
          },
          "_name": "apeople1",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs people1 charitym5\" group=\"People\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-tabs\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#303030\" condition=\"showIcon\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" name=\"tabsColor\" title=\"Color\" value=\"#303030\">\n        <input type=\"color\" name=\"activeColor\" title=\"Active Color\" value=\"#303030\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#aef80f\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f6f6f6\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay&&bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center align-items-stretch main-row\">\n            <div class=\"col-12 col-lg-6 col-img\">\n                <div class=\"item-img\">\n                    <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/poster-1.png\" alt=\"Our Fliers of Hope\"></a>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"content-wrap\">\n                    <div class=\"icon-wrap\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-quote-right mobi-mbri\"></span>\n                    </div>\n                    <div class=\"tabs-wrap\">\n                        <div class=\"tab-content\">\n                            <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                                <div class=\"row\">\n                                    <div class=\"col-12\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-2\">\n                                           <b>HOPE IN THE DARKEST HOUR.</b>\n                                        </p>\n                                        <p class=\"tabs-prof mbr-fonts-style mb-0\" data-app-selector=\".tabs-prof\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\"><b>\n                                            How your donation could be timely to safe a soul.</b></p>\n                                        <p class=\"tabs-name mbr-fonts-style mb-0\" data-app-selector=\".tabs-name\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\"A young woman's world was turned upside down when her husband lost his job, leaving them unable to afford her critical hospital care. But in their darkest moment, \n<br>compassionate donors like you stepped in, providing a timely donation through <b>Rock Messengers Outreach Inc.</b> With gratitude, she whispered,<b><i>&nbsp;\"Your generosity was a lifeline, easing our burden and giving  us hope for a brighter tomorrow.\"</i></b><br><br><b>Here are some ideas for Rock Messengers to feed children of the needy despite limited resources:\n</b><br>\n<br>1. Partner with local food banks or organizations.\n<br>2. Organize food drives or fundraising campaigns.\n<br>3. Seek donations from individuals or businesses.\n<br>4. Prepare and distribute nutritious meals or snacks..\n<br>5. Apply for grants or funding from foundations.\n<br>6. Engage volunteers to support in food distribution.\n<br><br><b><i>Remember, even small efforts can make a significant </i></b><br><b><i>impact when done with love and compassion!<br></i></b></p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                                <div class=\"row\">\n                                    <div class=\"col-12\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-2\">\n                                            <b>Vel facilisis volutpat est velit egestas tristique nulla aliquet.</b>\n                                        </p>\n                                        <p class=\"tabs-prof mbr-fonts-style mb-0\" data-app-selector=\".tabs-prof\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\">\n                                            Volunteer\n                                        </p>\n                                        <p class=\"tabs-name mbr-fonts-style mb-0\" data-app-selector=\".tabs-name\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                            <b>Monica Murphy</b>\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                                <div class=\"row\">\n                                    <div class=\"col-12\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-2\">\n                                            <b>Diam quis enim lobortis scelerisque fermentum dui faucibus neque.</b>\n                                        </p>\n                                        <p class=\"tabs-prof mbr-fonts-style mb-0\" data-app-selector=\".tabs-prof\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\"><b>Generosity that came as a Lifeline</b></p>\n                                        <p class=\"tabs-name mbr-fonts-style mb-0\" data-app-selector=\".tabs-name\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\"A young woman's world was turned upside down when her husband lost his job, leaving them unable to afford her critical hospital care. But in their darkest moment,\n<br>compassionate donors like you stepped in, providing a timely donation through Rock Messengers Outreach. <br><br>With a donor's gratitude, \"she whispered, 'Your generosity was a lifeline, easing our burden and giving us hope for a brighter tomorrow.'\"<br><br><b>Rock Messengers™</b>&nbsp;<br>Your Community Outreach Organisation.<br>We will always appreciate your support in<br>various ways.</p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                                <div class=\"row\">\n                                    <div class=\"col-12\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-2\">\n                                            <b>Eget arcu dictum varius duis at consectetur lorem turpis massa.</b>\n                                        </p>\n                                        <p class=\"tabs-prof mbr-fonts-style mb-0\" data-app-selector=\".tabs-prof\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\">\n                                            Volunteer\n                                        </p>\n                                        <p class=\"tabs-name mbr-fonts-style mb-0\" data-app-selector=\".tabs-name\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                            <b>Isabella Perry</b>\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <ul class=\"nav nav-tabs\" role=\"tablist\" mbr-if=\"bootstrapTabs > 1\">\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item first mbr-fonts-style\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style show active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab1\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    <b>01</b>\n                                </a>\n                            </li>\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab2\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    <b>02</b>\n                                </a>\n                            </li>\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#apeople1-0_tab2\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    <strong>03</strong><strong><br></strong>\n                                </a></li>\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab4\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    <b>04</b>\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
