          "_name": "apeople1",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs people1 charitym5\" group=\"People\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-tabs\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#1a6001\" condition=\"showIcon\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" name=\"tabsColor\" title=\"Color\" value=\"#303030\">\n        <input type=\"color\" name=\"activeColor\" title=\"Active Color\" value=\"#1a6001\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#fff6be\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f6f6f6\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay&&bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center align-items-stretch main-row\">\n            <div class=\"col-12 col-lg-6 col-img\">\n                <div class=\"item-img\">\n                    <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/cover-frontpage-web.png\" alt=\"Our Fliers of Hope\"></a>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"content-wrap\">\n                    <div class=\"icon-wrap\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-quote-right mobi-mbri\"></span>\n                    </div>\n                    <div class=\"tabs-wrap\">\n                        <div class=\"tab-content\">\n                            <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                                <div class=\"row\">\n                                    <div class=\"col-12\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-2\">\n                                           <b>TITLE HERE.</b></p>\n                                        <p class=\"tabs-prof mbr-fonts-style mb-0\" data-app-selector=\".tabs-prof\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\"><b>\n                                            BODY COPY OF THIS DESIGN</b></p>\n                                        <p class=\"tabs-name mbr-fonts-style mb-0\" data-app-selector=\".tabs-name\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\"CCDI is a mission-driven organization committed to addressing youth unemployment, community health, rehabilitation, family strengthening, and education through holistic empowerment, vocational training, child welfare, and sustainable social enterprise development. more bodycopy contents and well written comming into spaces to cover this contents spaces by the website owners or organisation team developer. This is bodycopy contentents structure, shall be completed with the correct and right bodycopy.\n<br>\n<br>CCDI is a mission-driven organization committed to addressing youth unemployment, community health, rehabilitation, family strengthening, and education through holistic empowerment, vocational training, child welfare, and sustainable social enterprise development. more bodycopy contents and well written comming into spaces to cover this contents spaces by the website owners or organisation team developer.<br><br>&nbsp;This is bodycopy contentents structure, shall be completed with the correct and right bodycopy.\n<br>\n<br><b><i><a href=\"account.html#donation2Support44\" class=\"text-danger\"><b>SUPPORT OUR CAUSE IN ANY WAYS YOU CAN</b></a></i></b></p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                                <div class=\"row\">\n                                    <div class=\"col-12\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-2\">\n                                            <b>Vel facilisis volutpat est velit egestas tristique nulla aliquet.</b>\n                                        </p>\n                                        <p class=\"tabs-prof mbr-fonts-style mb-0\" data-app-selector=\".tabs-prof\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\">\n                                            Volunteer\n                                        </p>\n                                        <p class=\"tabs-name mbr-fonts-style mb-0\" data-app-selector=\".tabs-name\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                            <b>Monica Murphy</b>\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                                <div class=\"row\">\n                                    <div class=\"col-12\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-2\">\n                                            <b>Diam quis enim lobortis scelerisque fermentum dui faucibus neque.</b>\n                                        </p>\n                                        <p class=\"tabs-prof mbr-fonts-style mb-0\" data-app-selector=\".tabs-prof\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\"><b>Generosity that came as a Lifeline</b></p>\n                                        <p class=\"tabs-name mbr-fonts-style mb-0\" data-app-selector=\".tabs-name\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\"A young woman's world was turned upside down when her husband lost his job, leaving them unable to afford her critical hospital care. But in their darkest moment,\n<br>compassionate donors like you stepped in, providing a timely donation through Rock Messengers Outreach. <br><br>With a donor's gratitude, \"she whispered, 'Your generosity was a lifeline, easing our burden and giving us hope for a brighter tomorrow.'\"<br><br><b>Rock Messengers™</b>&nbsp;<br>Your Community Outreach Organisation.<br>We will always appreciate your support in<br>various ways.</p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                                <div class=\"row\">\n                                    <div class=\"col-12\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-2\">\n                                            <b>Eget arcu dictum varius duis at consectetur lorem turpis massa.</b>\n                                        </p>\n                                        <p class=\"tabs-prof mbr-fonts-style mb-0\" data-app-selector=\".tabs-prof\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\">\n                                            Volunteer\n                                        </p>\n                                        <p class=\"tabs-name mbr-fonts-style mb-0\" data-app-selector=\".tabs-name\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                            <b>Isabella Perry</b>\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <ul class=\"nav nav-tabs\" role=\"tablist\" mbr-if=\"bootstrapTabs > 1\">\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item first mbr-fonts-style\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style show active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab1\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    <b>01</b>\n                                </a>\n                            </li>\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab2\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    <b>02</b>\n                                </a>\n                            </li>\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#apeople1-0_tab2\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    <strong>03</strong><strong><br></strong>\n                                </a></li>\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab4\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    <b>04</b>\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
