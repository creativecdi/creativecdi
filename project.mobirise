              }
            },
            ".mbr-text": {
              "color": "#503803",
              "margin-bottom": "35px",
              "text-align": "right"
            },
            ".items-wrap": {
              "display": "flex",
              "align-items": "flex-start",
              "column-gap": "50px",
              "@media (max-width: 575px)": {
                "flex-wrap": "wrap",
                "row-gap": "27px"
              }
            },
            ".item-wrap": {
              "width": "~\"calc(50% - 25px)\"",
              "@media (max-width: 575px)": {
