        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "overflow": "hidden",
            ".container": {
              "max-width": "100% !important"
            },
            ".mbr-section-head": {
              "max-width": "1300px",
              "width": "100%",
              "padding": "40px 0 50px",
              "margin": "0 auto",
              "@media (max-width: 1439px)": {
                "max-width": "1100px"
              },
              "@media (max-width: 1199px)": {
                "max-width": "960px"
              },
              "@media (max-width: 991px)": {
                "max-width": "86%"
              },
              "@media (max-width: 767px)": {
                "padding": "30px 0 40px"
              }
            },
            ".mbr-section-title": {
              "color": "#303030"
            },
            ".mbr-section-subtitle": {
              "color": "#303030",
              "margin-top": "16px"
            },
            ".items-row": {
              "position": "relative",
              "margin-top": "-1px",
              "margin-left": "-3px !important",
              "margin-right": "-3px !important",
              "& when (@showBorder)": {
                "border-top": "1px solid @borderColor",
                "&:after": {
                  "content": "\"\"",
                  "position": "absolute",
                  "bottom": "0",
                  "left": "0",
                  "height": "1px",
                  "width": "101vw",
                  "background-color": "@borderColor"
                }
              }
            },
            ".item-wrapper": {
              "width": "100%",
              "height": "100%",
              "padding": "15% 15% 13% 15%",
              "transition": ".3s all",
              "@media (max-width: 767px)": {
                "padding": "13% 7% 12%"
              }
            },
            ".item": {
              "padding": "0 !important",
              "margin": "-1px -1px 0",
              "overflow": "hidden",
              "& when (@showBorder)": {
                "border": "1px solid @borderColor"
              },
              "&:nth-child(1n)": {
                ".item-wrapper": {
                  "background": "linear-gradient(to left, @cardsBg 0 50%, @cardsBgHover 50% 100%)",
                  "background-size": "200% 100%",
                  "background-position": "right",
                  "&:hover": {
                    "background-position": "left"
                  }
                }
              },
              "&:nth-child(2n)": {
                ".item-wrapper": {
                  "background": "linear-gradient(to top, @cardsBg 0 50%, @cardsBgHover 50% 100%)",
                  "background-size": "100% 200%",
                  "background-position": "bottom",
                  "&:hover": {
                    "background-position": "top"
                  }
                }
              },
              "&:nth-child(3n)": {
                ".item-wrapper": {
                  "background": "linear-gradient(to right, @cardsBg 0 50%, @cardsBgHover 50% 100%)",
                  "background-size": "200% 100%",
                  "background-position": "left",
                  "&:hover": {
                    "background-position": "right"
                  }
                }
              }
            },
            ".item-img": {
              "width": "100%",
              "& when (@showBorder)": {
                "border": "1px solid @borderColor"
              },
              "img": {
                "width": "100%",
                "aspect-ratio": "~\"calc(425 / (124 * @{imgHeight}))\"",
                "object-fit": "cover"
              }
            },
            ".item-content": {
              "margin-top": "15px"
            },
            ".mbr-text": {
              "margin-top": "15px",
              "color": "#303030"
            },
            ".item-title": {
              "margin-top": "15px",
              "color": "#303030",
              "text-align": "center"
            },
            ".mbr-section-btn": {
              "padding-top": "10px",
              "margin-top": "auto !important"
            }
          },
          "_name": "agallery1",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery1 charitym5\" group=\"Sliders & Galleries\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n        <header>Cards</header>\n        <input type=\"range\" inline title=\"Image Height\" name=\"imgHeight\" min=\"1\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\">\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\">\n        <input type=\"color\" name=\"cardsBg\" title=\"BG\" value=\"#f0e8f8\">\n        <input type=\"color\" name=\"cardsBgHover\" title=\"BG Hover\" value=\"#d3bb81\">\n        <input type=\"checkbox\" name=\"showBorder\" title=\"Border\" checked>\n        <input type=\"color\" name=\"borderColor\" title=\"Border Color\" value=\"#E2E2E2\" condition=\"showBorder\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#c7f093\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div class=\"container\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                <b>Nam aliquam sem</b>\n            </h4>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                Massa sed elementum tempus egestas sed sed risus pretium quam.\n            </h5>\n        </div>\n        <div class=\"row items-row {{contentAlign}}\">\n\n\n            <div class=\"item features-image col-12 col-md-6 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/badagry-correctional-centre.png\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            <b>Visit to the NCS, Lagos State Custodial Centre.</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                            Amet nisl suscipit adipiscing bibendum est ultricies integer quis auctor.\n                        </p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\">\n                        <a href class=\"btn btn-black-outline item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                            READ MORE\n                        </a>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"item features-image col-12 col-md-6 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/a-snap-with-the-head-of-operation-of-badagry-correctional-center-after-receiving-our-gifts1.png\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            <b>Given in our little way to Nigerian Correctional Service - NCS.</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                            Venenatis lectus magna fringilla urna porttitor rhoncus dolor purus non.\n                        </p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\">\n                        <a href class=\"btn btn-black-outline item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                            READ MORE\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-md-6 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/giving-of-support-envelope.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            <b>Hospital Love with Welfare Officer at IGH, Lagos.</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                            Enim eu turpis egestas pretium aenean pharetra.\n                        </p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\">\n                        <a href class=\"btn btn-black-outline item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                            READ MORE\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
