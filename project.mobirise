              }
            },
            ".item-title": {
              "color": "#91712e",
              "margin-bottom": "18px",
              "text-align": "right"
            },
            ".list": {
              "list-style": "none",
              "padding-left": "0",
              "margin-bottom": "0",
              "margin-top": "0",
              "color": "#503803",
              "text-align": "right"
            },
