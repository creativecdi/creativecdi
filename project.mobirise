              ".hamburger": {
                "div": {
                  "display": "flex",
                  "justify-content": "space-between",
                  "align-items": "center",
                  "position": "absolute",
                  "right": "0",
                  "width": "100%",
                  "height": "4px",
                  "background-color": "transparent",
                  "opacity": "1",
                  "&:nth-child(1)": {
                    "top": "0",
                    "transition": "all 0.3s"
                  },
                  "&:nth-child(2)": {
                    "top": "10px",
                    "transition": "all 0.25s"
                  },
                  "&:nth-child(3)": {
                    "top": "10px",
                    "transition": "all 0.25s"
                  },
                  "&:nth-child(4)": {
                    "top": "20px",
                    "transition": "all 0.3s"
                  }
                },
                "span": {
                  "width": "4px",
                  "height": "4px",
                  "background-color": "@hamburgerColor",
                  "border-radius": "50%"
                }
              },
              "&:hover": {
                ".hamburger": {
                  "div": {
                    "&:nth-child(1)": {
                      "top": "10px",
                      "opacity": "0",
                      "transition": "all 0.3s"
                    },
                    "&:nth-child(2)": {
                      "top": "10px",
                      "transition": "all 0.25s",
                      "opacity": "1"
                    },
                    "&:nth-child(3)": {
                      "top": "10px",
                      "opacity": "1",
                      "transition": "all 0.25s"
                    },
                    "&:nth-child(4)": {
                      "top": "10px",
                      "opacity": "0",
                      "transition": "all 0.3s"
                    }
                  }
                }
              }
            },
            "nav.opened": {
              ".hamburger": {
                "div": {
                  "&:nth-child(1)": {
                    "top": "10px",
                    "opacity": "0"
                  },
                  "&:nth-child(2)": {
                    "top": "10px",
                    "opacity": "1",
                    "transform": "rotate(45deg)",
                    "background-color": "@hamburgerColor"
                  },
                  "&:nth-child(3)": {
                    "top": "10px",
                    "opacity": "1",
                    "transform": "rotate(-45deg)",
                    "background-color": "@hamburgerColor"
                  },
                  "&:nth-child(4)": {
