              },
              ".navbar-logo": {
                "margin-right": "0.5rem !important",
                "img": {
                  "width": "auto"
                }
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "z-index": "1"
              },
              "&.collapsed": {
                "justify-content": "center",
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
