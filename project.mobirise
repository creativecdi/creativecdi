          "_name": "afeatures4",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features4 charitym5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#1a6001\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f6f6f6\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f6f6f6\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container-fluid\">\n        <div class=\"row {{contentAlign}} cards-row\">\n\n            <div class=\"card col-12 col-sm-4\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-users mobi-mbri\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Feeding Needy</b></h4>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-sm-4\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper\">\n                    <a href=\"#\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-hearth mobi-mbri\"></span></a>\n                    <div class=\"card-box\" mbr-if=\"showTitle\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Nourishing Hope</b></h4>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-sm-4\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont sli-wallet\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Building trust</b></h4>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-sm-4\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-home mobi-mbri\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Building trust</b></h4>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-sm-4\" mbr-if=\"cardsAmount > 4\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-like mobi-mbri\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Stronger community</b></h4>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "ul3dgTdFn5",
          "_anchor": "afeatures4-24",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "overflow": "hidden",
            ".row": {
              "row-gap": "50px"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".text-wrap": {
              "width": "100%",
              "padding-right": "30px",
              "@media (max-width: 1439px)": {
                "padding-right": "15px"
              },
              "& when (@reverseContent)": {
                "padding-left": "30px",
                "padding-right": "0",
                "@media (max-width: 1439px)": {
                  "padding-left": "15px",
                  "padding-right": "0"
                }
              },
              "@media (max-width: 991px)": {
                "padding": "0"
              }
            },
            ".mbr-section-title": {
              "color": "#303030"
            },
            ".mbr-text": {
              "color": "#303030",
              "margin-top": "16px"
            },
            ".line-items-wrap": {
              "display": "flex",
              "align-items": "flex-start",
              "justify-content": "space-between",
              "flex-wrap": "wrap",
              "row-gap": "30px",
              "width": "100%"
            },
            ".line-item": {
              "display": "flex",
              "flex-wrap": "wrap",
              "width": "100%"
            },
            ".line-text-wrap": {
              "display": "flex",
              "align-items": "flex-end",
              "width": "100%",
              "margin-bottom": "7px"
            },
            ".line-text": {
              "color": "#303030",
              "margin-right": "auto",
              "max-width": "50%"
            },
            ".line-number": {
              "color": "#303030",
              "margin-left": "auto",
              "max-width": "40%"
            },
            ".line": {
              "position": "relative",
              "width": "100%",
              "height": "4px",
              "background-color": "#EAEAEA"
            },
            ".line-active": {
              "position": "absolute",
              "left": "0",
              "top": "0",
              "height": "100%",
              "background-color": "@lineColor"
            },
            ".line-item-1": {
              ".line-number": {
                "&:before": {
                  "content": "\"@{line1}\""
                }
              },
              ".line-active": {
                "width": "~\"@{line1}%\""
              }
            },
            ".line-item-2": {
              ".line-number": {
                "&:before": {
                  "content": "\"@{line2}\""
                }
              },
              ".line-active": {
                "width": "~\"@{line2}%\""
              }
            },
            ".line-item-3": {
              ".line-number": {
                "&:before": {
                  "content": "\"@{line3}\""
                }
              },
              ".line-active": {
                "width": "~\"@{line3}%\""
              }
            }
          },
          "_name": "afeatures8",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features8 charitym5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Line Text\" name=\"showLineText\" checked>\n        <input type=\"checkbox\" title=\"Line Percent\" name=\"showLinePercent\" checked>\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#1f6f03\">\n        <input type=\"range\" inline title=\"Line Count\" name=\"lineCount\" min=\"1\" max=\"3\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Line 1\" name=\"line1\" min=\"0\" max=\"100\" step=\"1\" value=\"40\">\n        <input type=\"range\" inline title=\"Line 2\" name=\"line2\" min=\"0\" max=\"100\" step=\"1\" value=\"59\" condition=\"lineCount > 1\">\n        <input type=\"range\" inline title=\"Line 3\" name=\"line3\" min=\"0\" max=\"100\" step=\"1\" value=\"87\" condition=\"lineCount > 2\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f6f6f6\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background4.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f6f6f6\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row align-items-start\">\n\n            <div class=\"col-12 col-lg-6 col-text\">\n                <div class=\"text-wrap\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>HOPE IN THE DARKEST HOUR</b></h3>\n                    <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-text\"><b>\n                        \"</b>A young woman's world was turned upside down when her husband lost his job, leaving them unable to afford her critical hospital care. But in their darkest moment, compassionate donors like you stepped in, providing a timely donation through Rock Messengers Outreach. With gratitude, she whispered, 'Your generosity was a lifeline, easing our burden and giving  us hope for a brighter tomorrow.<b>\"</b></p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 col-lines\">\n                <div class=\"line-items-wrap\">\n                    <div class=\"line-item line-item-1\">\n                        <div class=\"line-text-wrap\">\n                            <p class=\"line-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showLineText\" data-app-selector=\".line-text\"><b>Correctional Care</b></p>\n                            <p class=\"line-number line-number mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".line-number\" mbr-if=\"showLinePercent\">%</p>\n                        </div>\n                        <div class=\"line\">\n                            <div class=\"line-active\"></div>\n                        </div>\n                    </div>\n\n                    <div class=\"line-item line-item-2\" mbr-if=\"lineCount > 1\">\n                        <div class=\"line-text-wrap\">\n                            <p class=\"line-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showLineText\" data-app-selector=\".line-text\"><b>Hospital Bills Relief</b></p>\n                            <p class=\"line-number mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".line-number\" mbr-if=\"showLinePercent\">%</p>\n                        </div>\n                        <div class=\"line\">\n                            <div class=\"line-active\"></div>\n                        </div>\n                    </div>\n\n                    <div class=\"line-item line-item-3\" mbr-if=\"lineCount > 2\">\n                        <div class=\"line-text-wrap\">\n                            <p class=\"line-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showLineText\" data-app-selector=\".line-text\"><b>Rehabilitation&nbsp;<br>Support</b></p>\n                            <p class=\"line-number mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".line-number\" mbr-if=\"showLinePercent\">%</p>\n                        </div>\n                        <div class=\"line\">\n                            <div class=\"line-active\"></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_cid": "ul3dgUlmdO",
          "_anchor": "afeatures8-25",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-text": {
              "color": "#303030"
            },
            ".media-container-row .mbr-text": {
              "color": "#ffe2da"
            }
          },
          "_name": "afooter2",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer2 charitym5\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f6f6f6\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div class=\"container\">\n        <div class=\"media-container-row align-center mbr-white\">\n            <div class=\"col-12\">\n                <p class=\"mbr-text mb-0 mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".media-container-row .mbr-text\" data-app-placeholder=\"Type Text\">\n                    © Copyright 2026 The Creative Craft Development Initiative (<b>CCDI</b>) - All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vv9EYkiTcr",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {},
          "_anchor": "afooter2-2t"
        }
      ]
    },
    "page5.html": {
      "settings": {
        "title": "VIDEOS - Rock Messengers Outreach Foundation",
        "order": "1"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "100px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
              "padding": "15px 0",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
              "& when (@showBorder)": {
                "border": "2px solid @borderColor !important"
              }
            },
            ".dropdown-item": {
              "position": "relative !important",
              "padding": "2px 40px !important",
              "&:after": {
                "right": "1rem !important"
              },
              "&:before": {
                "content": "\"\"",
                "display": "block !important",
                "position": "absolute",
                "left": "40px",
                "bottom": "2px",
                "top": "auto !important",
                "height": "1px",
                "width": "0",
                "overflow": "visible !important",
                "transform": "scale(1) !important",
                "background-color": "currentColor",
                "transition": "0.4s cubic-bezier(0.33, 0.52, 0.05, 0.96)"
              },
              "&:hover, &:focus": {
                "&:before": {
                  "width": "~\"calc(100% - 80px)\""
                }
              }
            },
            ".nav-dropdown .link": {
              "padding": "0 0.3em !important",
              "margin": "0.667em 1em !important"
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem"
            },
            ".nav-link": {
              "position": "relative"
            },
            ".container": {
              "display": "flex",
              "margin": "auto",
              "& when not (@collapsed)": {
                "@media (min-width: 992px)": {
                  "flex-wrap": "nowrap"
                }
              }
            },
            ".navbar-caption": {},
            ".navbar-nav": {
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "flex-wrap": "wrap",
              "margin-right": "auto",
              "min-height": "98px",
              ".nav-item": {
                "margin": "0"
              },
              ".nav-link": {
                "position": "relative",
                "padding": "0 !important",
                "margin": "10px 20px !important",
                "transition": ".4s all",
                "font-weight": "700 !important",
                "&:before": {
                  "content": "\"\"",
                  "display": "block !important",
                  "position": "absolute",
                  "left": "0",
                  "bottom": "0",
                  "height": "2px",
                  "width": "0",
                  "background-color": "currentColor",
                  "transition": "0.4s cubic-bezier(0.33, 0.52, 0.05, 0.96)"
                },
                "&:hover": {
                  "&:before": {
                    "width": "100%"
                  }
                }
              }
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
              "transition": "all 0.25s ease-in-out",
              "&::after": {
                "right": "0.5rem"
              },
              ".mbr-iconfont": {
                "margin-right": "0.5rem",
                "vertical-align": "sub",
                "&:before": {
                  "display": "inline-block",
                  "transform": "scale(1, 1)",
                  "transition": "all 0.25s ease-in-out"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar": {
              "min-height": "100px",
              "transition": "all 0.3s",
              "border-bottom": "none !important",
              "&:not(.navbar-short)": {},
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".dropdown-item": {
                "padding": "0.5rem 1.8rem"
              },
              ".navbar-logo": {
                "margin-right": "0.5rem !important",
                "img": {
                  "width": "auto"
                }
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "z-index": "1"
              },
              "&.collapsed": {
                "justify-content": "center",
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  },
                  "@media (min-width: 992px)": {
                    "&:not(.navbar-short) .navbar-collapse when (@showLogo)": {
                      "max-height": "~\"calc(98.5vh - @{logoSize}rem)\""
                    }
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "41%"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem",
                  "text-align": "center"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-right": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "@media (max-width: 991px)": {
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "40%"
                  }
                },
                ".navbar-logo": {
                  "img": {
                    "height": "3rem !important"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem !important",
                  "text-align": "center"
                },
                ".navbar-brand": {
                  "flex-shrink": "initial",
                  "flex-basis": "auto",
                  "word-break": "break-word",
                  "padding-right": "2rem",
                  "@media (max-width: 767px)": {
                    "width": "~\"calc(100% - 31px)\""
                  }
                },
                ".navbar-toggler": {
                  "flex-basis": "auto"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "&.navbar-short": {
                "min-height": "100px",
                ".navbar-brand": {
                  "min-height": "98px",
                  "padding": "0"
                }
              },
              "& when (@showBorder)": {
                "border-bottom": "2px solid @borderColor !important"
              },
              "box-shadow": "none !important",
              "padding": "0 !important"
            },
            ".navbar-brand": {
              "min-height": "98px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "word-break": "break-word",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important"
              },
              ".navbar-logo a": {
                "outline": "none"
              },
              "padding-right": "50px !important"
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            ".navbar-expand-lg .navbar-nav .nav-link": {
              "padding": "0"
            },
            ".nav-dropdown .link.dropdown-toggle": {
              "margin-right": "1.667em",
              "&[aria-expanded=\"true\"]": {
                "margin-right": "0",
                "padding": "0.667em 1.667em"
              }
            },
            ".navbar.navbar-expand-lg .dropdown": {
              ".dropdown-menu": {
                "background": "@menuBgColor",
                ".dropdown-submenu": {
                  "margin": "0",
                  "left": "100%"
                }
              }
            },
            ".navbar .dropdown.open > .dropdown-menu": {
              "display": "block"
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap"
            },
            ".navbar-buttons": {
              "text-align": "center"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "24px",
              "height": "24px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "padding": "0 !important",
              "border": "none !important",
              ".hamburger": {
                "div": {
                  "display": "flex",
                  "justify-content": "space-between",
                  "align-items": "center",
                  "position": "absolute",
                  "right": "0",
                  "width": "100%",
                  "height": "4px",
                  "background-color": "transparent",
                  "opacity": "1",
                  "&:nth-child(1)": {
                    "top": "0",
                    "transition": "all 0.3s"
                  },
                  "&:nth-child(2)": {
                    "top": "10px",
                    "transition": "all 0.25s"
                  },
                  "&:nth-child(3)": {
                    "top": "10px",
                    "transition": "all 0.25s"
                  },
                  "&:nth-child(4)": {
                    "top": "20px",
                    "transition": "all 0.3s"
                  }
                },
                "span": {
                  "width": "4px",
                  "height": "4px",
                  "background-color": "@hamburgerColor",
                  "border-radius": "50%"
                }
              },
              "&:hover": {
                ".hamburger": {
                  "div": {
                    "&:nth-child(1)": {
                      "top": "10px",
                      "opacity": "0",
                      "transition": "all 0.3s"
                    },
                    "&:nth-child(2)": {
                      "top": "10px",
                      "transition": "all 0.25s",
                      "opacity": "1"
                    },
                    "&:nth-child(3)": {
                      "top": "10px",
                      "opacity": "1",
                      "transition": "all 0.25s"
                    },
                    "&:nth-child(4)": {
                      "top": "10px",
                      "opacity": "0",
                      "transition": "all 0.3s"
                    }
                  }
                }
              }
            },
            "nav.opened": {
              ".hamburger": {
                "div": {
                  "&:nth-child(1)": {
                    "top": "10px",
                    "opacity": "0"
                  },
                  "&:nth-child(2)": {
                    "top": "10px",
                    "opacity": "1",
                    "transform": "rotate(45deg)",
                    "background-color": "@hamburgerColor"
                  },
                  "&:nth-child(3)": {
                    "top": "10px",
                    "opacity": "1",
                    "transform": "rotate(-45deg)",
                    "background-color": "@hamburgerColor"
                  },
                  "&:nth-child(4)": {
                    "top": "10px",
                    "opacity": "0",
                    "transition": "all 0.3s"
                  }
                }
              },
              "button.navbar-toggler": {
                "&:hover": {
                  "transform": "rotate(90deg)"
                }
              }
            },
            ".navbar-dropdown": {
              "padding": "0 1rem",
              "& when (@sticky)": {
                "position": "fixed"
              }
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".icons-menu": {
              "flex-wrap": "nowrap",
              "display": "flex",
              "justify-content": "center",
              "padding-left": "1rem",
              "padding-right": "1rem",
              "padding-top": "0.3rem",
              "text-align": "center"
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".navbar": {
                "height": "70px",
                "&.opened": {
                  "height": "auto"
                }
              },
              ".nav-item .nav-link:hover::before": {
                "width": "175%",
                "max-width": "calc(100% ~\"+\" 2rem)",
                "left": "-1rem"
              }
            },
            ".container, .container-fluid": {
              "flex-wrap": "nowrap",
              "@media (max-width: 991px)": {
                "flex-wrap": "wrap"
              }
            },
            ".container-fluid": {
              "max-width": "100%",
              "padding": "0 60px"
            },
            ".navbar-collapse": {
              "min-height": "98px"
            },
            ".mbr-section-btn": {
              "max-width": "35%",
              ".btn": {
                "min-width": "auto",
                "max-width": "100%"
              }
            },
            "& when (@collapsed)": {
              ".container, .container-fluid": {
                "flex-wrap": "wrap"
              },
              ".navbar-brand": {
                "width": "auto",
                "min-height": "98px"
              },
              ".navbar-collapse": {
                "width": "100%",
                "min-height": "auto",
                "padding-bottom": "30px",
                "order": "5"
              },
              ".navbar-nav": {
                "width": "100%",
                "padding-top": "30px",
                "align-items": "flex-start",
                "li": {
                  "margin": "0 !important"
                },
                ".nav-link": {
                  "width": "max-content !important",
                  "max-width": "100% !important",
                  "margin": "5px 0 !important"
                }
              },
              ".navbar .navbar-collapse .dropdown .dropdown-menu": {
                "padding": "8px 0 !important",
                "box-shadow": "none !important",
                "background": "transparent !important",
                "border": "none !important",
                ".dropdown-item": {
                  "padding": "2px 0 !important",
                  "width": "max-content !important",
                  "max-width": "100% !important",
                  "&:before": {
                    "left": "0 !important",
                    "bottom": "2px !important"
                  },
                  "&:hover": {
                    "&:before": {
                      "width": "100% !important"
                    }
                  }
                }
              },
              ".mbr-section-btn": {
                "max-width": "100%",
                "margin-top": "10px"
              }
            },
            "@media (max-width: 991px)": {
              "min-height": "70px !important",
              ".navbar": {
                "min-height": "70px !important"
              },
              ".container-fluid": {
                "padding": "0 7%"
              },
              ".navbar-brand": {
                "width": "~\"calc(100% - 24px)\" !important",
                "min-height": "68px !important",
                "padding-right": "0 !important"
              },
              ".navbar-collapse": {
                "width": "100%",
                "min-height": "auto",
                "padding-bottom": "30px",
                "order": "5"
              },
              ".navbar-nav": {
                "width": "100%",
                "padding-top": "30px",
                "align-items": "flex-start",
                "li": {
                  "margin": "0 !important"
                },
                ".nav-link": {
                  "width": "max-content !important",
                  "max-width": "100% !important",
                  "margin": "5px 0 !important"
                }
              },
              ".navbar .navbar-collapse .dropdown .dropdown-menu": {
                "padding": "8px 0 !important",
                "box-shadow": "none !important",
                "background": "transparent !important",
                "border": "none !important",
                ".dropdown-item": {
                  "padding": "2px 0 !important",
                  "width": "max-content !important",
                  "max-width": "100% !important",
                  "&:before": {
                    "left": "0 !important",
                    "bottom": "2px !important"
                  },
                  "&:hover": {
                    "&:before": {
                      "width": "100% !important"
                    }
                  }
                }
              },
              ".mbr-section-btn": {
                "max-width": "100%",
                "margin-top": "10px"
              }
            }
          },
          "_name": "amenu2",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu2 charitym5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"4.4\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#ffeb08\" condition=\"showBorder\">\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#024616\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ffc608\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://creativecdi.org\">\n                        <img src=\"@PROJECT_PATH@/assets/images/name-top-logo2.webp\" alt=\"The Creative Craft Development Initiative (CCDI)\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-warning\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">CCDI<br></a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <div>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                    <div>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                    <div></div>\n                    <div>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\"><span class=\"fa fa-home mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 25px; color: rgb(243, 223, 14);\"></span>HOME</a></li><li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link text-white dropdown-toggle show\" href=\"index.html#aheadavid-okem1-4\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\"><span class=\"fa fa-book mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(243, 223, 14);\"></span>ABOUT</a><div class=\"dropdown-menu show\" aria-labelledby=\"dropdown-943\" data-bs-popper=\"none\"><a class=\"text-white dropdown-item\" href=\"index.html#aheadavid-okem1-4\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">ABOUT CCDI</a><a class=\"text-white dropdown-item\" href=\"index.html#aheadavid-okem1-4\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">VISION AND MISSION&nbsp;</a><a class=\"text-white dropdown-item\" href=\"index.html#aheadavid-okem1-4\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">CORE VALUES</a><a class=\"text-white dropdown-item\" href=\"index.html#aheadavid-okem1-4\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">IMPACT STATISTICS</a><a class=\"text-white dropdown-item\" href=\"index.html#aheadavid-okem1-4\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">PARTNERSHIP</a></div>\n                    </li>\n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link text-white dropdown-toggle\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\"><span class=\"mdi-notification-event-note mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(243, 223, 14);\"></span>PROJECTS</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-311\"><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">New Item</a><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">New Item</a><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">New Item</a><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\"><span class=\"mobi-mbri mobi-mbri-gift mbr-iconfont mbr-iconfont-btn\"></span>New Item</a></div>\n                    </li><li class=\"nav-item dropdown\"><a class=\"nav-link link text-white dropdown-toggle\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\"><span class=\"li_megaphone mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(243, 223, 14);\"></span>EXPLORE</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-981\"><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">New Item</a><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">New Item</a><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">New Item</a><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">New Item</a></div></li><li class=\"nav-item dropdown\"><a class=\"nav-link link dropdown-toggle text-white\" href=\"page5.html#eb-youtube-feed-2b\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\"><span class=\"fa fa-play-circle mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(243, 223, 14);\"></span>MEDIA</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-516\"><a class=\"dropdown-item text-white\" href=\"page5.html#eb-youtube-feed-2b\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\"><span class=\"mdi-av-videocam mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(255, 235, 8);\"></span>EVENT VIDEOS</a><a class=\"show dropdown-item text-white\" href=\"page5.html#eb-youtube-feed-2b\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\"><span class=\"li_camera mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(255, 235, 8);\"></span>PHOTO GALLERY</a><a class=\"text-white show dropdown-item\" href=\"page5.html#eb-youtube-feed-2b\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v2-design-document mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(255, 235, 8);\"></span>PDF DOCUMENTS</a><a class=\"text-white show dropdown-item\" href=\"page5.html#eb-youtube-feed-2b\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\"><span class=\"mdi-social-school mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(255, 235, 8);\"></span>CERTIFICATION</a></div></li><li class=\"nav-item\"><a class=\"nav-link link text-white\" href=\"contact.html#aform2-1k\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\"><span class=\"mdi-maps-pin-drop mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(243, 223, 14);\"></span>CONTACT</a></li></ul>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-danger\" href=\"account.html#donation2Support44\" data-app-placeholder=\"Type Text\">DONATION</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "ttjgGSzu1K",
          "_anchor": "amenu2-29",
          "_protectedParams": [],
