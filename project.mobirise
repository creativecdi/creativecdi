                "height": "44px",
                "border": "none !important",
                "border-bottom": "2px solid #303030 !important",
                "background": "transparent",
                "outline": "none !important",
                "box-shadow": "none !important",
                "border-radius": "0 !important",
                "margin-bottom": "0",
                "padding": "5px 0",
                "font-size": "19px",
                "line-height": "28px",
                "color": "#303030",
                "font-weight": "400",
                "transition": ".3s",
                "&::-webkit-input-placeholder": {
                  "color": "#303030"
                },
                "&::-moz-placeholder": {
                  "color": "#303030"
                },
                "&:-moz-placeholder": {
                  "color": "#303030"
                },
                "&:-ms-input-placeholder": {
                  "color": "#303030"
                }
              },
