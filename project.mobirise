          "_name": "apeople2",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"people2 charitym5\" group=\"People\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\" checked>\n        <header>Cards</header>\n        <input type=\"range\" inline title=\"Image Height\" name=\"imgHeight\" min=\"1\" max=\"6\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\" checked>\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#303030\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Icons Hover Color\" name=\"iconsHoverColor\" value=\"#9b8db7\" condition=\"showIcons\">\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Button\">\n        <input type=\"checkbox\" name=\"showBg\" title=\"Card Bg\" checked>\n        <input type=\"color\" title=\"Bg Color\" name=\"bgColor\" value=\"#f6f6f6\" condition=\"showBg\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#FFFFFF\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div class=\"container\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                <b>OUR VOLUNTEERS</b>\n            </h4>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                Our Volunteers spread across different zones and places of identification,&nbsp;<br>if you are interested to be part of this cause, kindly <a href=\"index.html#informUs2-b\" class=\"text-primary\"><b>get in touch</b></a></h5>\n        </div>\n        <div class=\"row items-row {{contentAlign}}\">\n\n            <div class=\"item features-image col-12 col-md-6 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/people1-1.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showText || showIcons || showButtons\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Chief Servant Volunteer\n                        </p>\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\"><b>Pst. David Nwaorah</b></h5>\n                        <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                            <a class=\"iconfont-wrapper\" href=\"https://web.facebook.com\" target=\"_blank\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper\" href=\"https://x.com\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper\" href=\"https://instagram.com\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-linkedin socicon\"></span>\n                            </a>\n                        </div>\n                        <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-7\">\n                            <a href class=\"btn btn-black-outline item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                                READ MORE\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"item features-image col-12 col-md-6 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/patricia.png\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showText || showIcons || showButtons\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Pioneer Volunteer\n                        </p>\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">\n                            <b>Evg. Patricia David&nbsp;</b></h5>\n                        <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                            <a class=\"iconfont-wrapper\" href=\"https://web.facebook.com\" target=\"_blank\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper\" href=\"https://x.com\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper\" href=\"https://instagram.com\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-linkedin socicon\"></span>\n                            </a>\n                        </div>\n                        <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-7\">\n                            <a href class=\"btn btn-black-outline item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                                READ MORE\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-md-6 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/cy-robinson-1.png\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showText || showIcons || showButtons\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                            Volunteer\n                        </p>\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .mbr-section-btn\" mbr-if=\"showCardTitle\">\n                            <b>Bro. Robinson Cyril</b></h5>\n                        <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                            <a class=\"iconfont-wrapper\" href=\"https://web.facebook.com/cyrilrobinsonpr\" target=\"_blank\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper\" href=\"https://x.com\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper\" href=\"https://instagram.com\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\"></span>\n                            </a>\n                            <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-linkedin socicon\"></span>\n                            </a>\n                        </div>\n                        <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-7\">\n                            <a href class=\"btn btn-black-outline item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                                READ MORE\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_cid": "ukzU9itdBE",
          "_anchor": "apeople2-1h",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "overflow": "hidden",
            ".row": {
              "row-gap": "50px"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".text-wrap": {
              "width": "100%",
              "padding-right": "30px",
              "@media (max-width: 1439px)": {
                "padding-right": "15px"
              },
              "& when (@reverseContent)": {
                "padding-left": "30px",
                "padding-right": "0",
                "@media (max-width: 1439px)": {
                  "padding-left": "15px",
                  "padding-right": "0"
                }
              },
              "@media (max-width: 991px)": {
                "padding": "0"
              }
            },
            ".mbr-section-title": {
              "color": "#303030"
            },
            ".mbr-text": {
              "color": "#303030",
              "margin-top": "16px"
            },
            ".line-items-wrap": {
              "display": "flex",
              "align-items": "flex-start",
              "justify-content": "space-between",
              "flex-wrap": "wrap",
              "row-gap": "30px",
              "width": "100%"
            },
            ".line-item": {
              "display": "flex",
              "flex-wrap": "wrap",
              "width": "100%"
            },
            ".line-text-wrap": {
              "display": "flex",
              "align-items": "flex-end",
              "width": "100%",
              "margin-bottom": "7px"
            },
            ".line-text": {
              "color": "#303030",
              "margin-right": "auto",
              "max-width": "50%"
            },
            ".line-number": {
              "color": "#303030",
              "margin-left": "auto",
              "max-width": "40%"
            },
            ".line": {
              "position": "relative",
              "width": "100%",
              "height": "4px",
              "background-color": "#EAEAEA"
            },
            ".line-active": {
              "position": "absolute",
              "left": "0",
              "top": "0",
              "height": "100%",
              "background-color": "@lineColor"
            },
            ".line-item-1": {
              ".line-number": {
                "&:before": {
                  "content": "\"@{line1}\""
                }
              },
              ".line-active": {
                "width": "~\"@{line1}%\""
              }
            },
            ".line-item-2": {
              ".line-number": {
                "&:before": {
                  "content": "\"@{line2}\""
                }
              },
              ".line-active": {
                "width": "~\"@{line2}%\""
              }
            },
            ".line-item-3": {
              ".line-number": {
                "&:before": {
                  "content": "\"@{line3}\""
                }
              },
              ".line-active": {
                "width": "~\"@{line3}%\""
              }
            }
          },
          "_name": "afeatures8",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features8 charitym5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Line Text\" name=\"showLineText\" checked>\n        <input type=\"checkbox\" title=\"Line Percent\" name=\"showLinePercent\" checked>\n        <input type=\"color\" title=\"Line Color\" name=\"lineColor\" value=\"#1f6f03\">\n        <input type=\"range\" inline title=\"Line Count\" name=\"lineCount\" min=\"1\" max=\"3\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Line 1\" name=\"line1\" min=\"0\" max=\"100\" step=\"1\" value=\"40\">\n        <input type=\"range\" inline title=\"Line 2\" name=\"line2\" min=\"0\" max=\"100\" step=\"1\" value=\"59\" condition=\"lineCount > 1\">\n        <input type=\"range\" inline title=\"Line 3\" name=\"line3\" min=\"0\" max=\"100\" step=\"1\" value=\"87\" condition=\"lineCount > 2\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f6f6f6\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background4.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f6f6f6\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row align-items-start\">\n\n            <div class=\"col-12 col-lg-6 col-text\">\n                <div class=\"text-wrap\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>HOPE IN THE DARKEST HOUR</b></h3>\n                    <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-text\"><b>\n                        \"</b>A young woman's world was turned upside down when her husband lost his job, leaving them unable to afford her critical hospital care. But in their darkest moment, compassionate donors like you stepped in, providing a timely donation through Rock Messengers Outreach. With gratitude, she whispered, 'Your generosity was a lifeline, easing our burden and giving  us hope for a brighter tomorrow.<b>\"<br><br><a href=\"account.html#donation2Support44\" class=\"text-primary\">PLEASE DONATE</a></b></p>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 col-lines\">\n                <div class=\"line-items-wrap\">\n                    <div class=\"line-item line-item-1\">\n                        <div class=\"line-text-wrap\">\n                            <p class=\"line-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showLineText\" data-app-selector=\".line-text\"><b>Correctional Care</b></p>\n                            <p class=\"line-number line-number mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".line-number\" mbr-if=\"showLinePercent\">%</p>\n                        </div>\n                        <div class=\"line\">\n                            <div class=\"line-active\"></div>\n                        </div>\n                    </div>\n\n                    <div class=\"line-item line-item-2\" mbr-if=\"lineCount > 1\">\n                        <div class=\"line-text-wrap\">\n                            <p class=\"line-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showLineText\" data-app-selector=\".line-text\"><b>Hospital Bills Relief</b></p>\n                            <p class=\"line-number mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".line-number\" mbr-if=\"showLinePercent\">%</p>\n                        </div>\n                        <div class=\"line\">\n                            <div class=\"line-active\"></div>\n                        </div>\n                    </div>\n\n                    <div class=\"line-item line-item-3\" mbr-if=\"lineCount > 2\">\n                        <div class=\"line-text-wrap\">\n                            <p class=\"line-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showLineText\" data-app-selector=\".line-text\"><b>Rehabilitation&nbsp;<br>Support</b></p>\n                            <p class=\"line-number mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".line-number\" mbr-if=\"showLinePercent\">%</p>\n                        </div>\n                        <div class=\"line\">\n                            <div class=\"line-active\"></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_cid": "ukzU9hyL90",
          "_anchor": "afeatures8-1g",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
