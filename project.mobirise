                "order": "2"
              }
            },
            ".item-img": {
              "height": "100%",
              "width": "100%",
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover"
              }
            },
            ".content-wrap": {
              "display": "flex",
              "align-items": "flex-start",
              "width": "100%",
              "padding": "75px 100px 130px 80px",
              "& when not (@fullWidth)": {
                "padding": "65px 60px 100px 40px"
              },
              "@media (max-width: 1439px)": {
                "padding": "55px 50px 100px 50px",
                "& when not (@fullWidth)": {
                  "padding": "35px 40px 70px 30px"
                }
              },
              "@media (max-width: 991px)": {
                "padding": "75px 80px 70px 80px",
                "& when not (@fullWidth)": {
                  "padding": "65px 40px 50px 40px"
                }
              },
              "@media (max-width: 767px)": {
                "padding": "70px 25px 70px 25px",
                "& when not (@fullWidth)": {
                  "padding": "60px 2px 50px 2px"
                }
              }
            },
            ".icon-wrap": {
              "margin-right": "15px",
              ".mbr-iconfont": {
                "font-size": "32px",
                "color": "@iconColor"
              }
            },
            ".tabs-wrap": {
              "flex-grow": "1"
            },
            ".mbr-text": {
              "margin-bottom": "30px",
              "color": "#000000",
              "text-align": "center"
            },
            ".tabs-prof": {
              "color": "#303030",
              "text-decoration": "underline",
              "text-align": "center"
            },
            ".tabs-name": {
              "margin-top": "6px",
              "color": "#000000",
              "text-align": "center"
            },
            ".nav-tabs .nav-item.open .nav-link:focus, .nav-tabs .nav-link.active:focus": {
              "outline": "none"
            },
            ".nav-tabs": {
              "flex-wrap": "wrap",
              "margin-top": "40px",
              "border": "none !important"
            },
            ".nav-item": {
              "margin-right": "25px"
            },
            ".nav-link": {
              "position": "relative",
              "padding": "0",
              "margin-bottom": "20px",
              "transition": "all .5s",
              "border": "none",
              "border-radius": "0 !important",
              "&:not(.active)": {
                "color": "@tabsColor"
              },
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "left": "0",
                "bottom": "0",
                "height": "2px",
                "width": "100%",
                "background-color": "currentColor",
                "transform": "scaleX(0)",
                "transform-origin": "left",
                "transition": "transform 1s cubic-bezier(0.33, 0.52, 0.05, 0.96)"
              },
              "&:hover": {
                "&:before": {
                  "transform": "scaleX(1)"
                }
              }
            },
            ".nav-tabs .nav-link.active": {
              "color": "@activeColor",
              "background-color": "transparent !important",
              "&:before": {
                "transform": "scaleX(1)"
              }
            }
