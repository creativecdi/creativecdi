            ".panel-title": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding": "12px 10px 20px 0",
              "color": "#303030",
              "transition": ".2s all",
              "&[aria-expanded=\"true\"]": {
                "padding": "12px 10px 13px 0",
                ".mbr-iconfont": {
                  "transform": "rotate(180deg)"
                }
              }
