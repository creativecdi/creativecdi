          "_name": "afeatures7",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features7 charitym5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Number\" name=\"showNumber\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#FFFFFF\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row {{contentAlign}} cards-row\">\n\n            <div class=\"card col-12 col-lg-4\">\n                <div class=\"card-wrapper\">\n                    <h3 class=\"number-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showNumber\" data-app-selector=\".number-text\">\n                        <b>01</b>\n                    </h3>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText || showButtons\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Emotional Support</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text, .mbr-section-btn\">- Counseling services<br><br>- Mentoring programs<br><br>- Peer support groups<br><br>- Spiritual guidance<br><br>- Listening ear and&nbsp; &nbsp; &nbsp;companionship.\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-black-outline\" href=\"#\" data-app-placeholder=\"Type Text\">\n                                READ MORE\n                            </a></div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper\">\n                    <h3 class=\"number-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showNumber\" data-app-selector=\".number-text\">\n                        <b>02</b>\n                    </h3>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText || showButtons\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            <b>Resources</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text, .mbr-section-btn\">- Financial assistance (e.g., bill payments, scholarships)<br><br>- Access to healthcare and medical services<br><br>- Educational materials and training<br><br>- Job skills development and employment opportunities<br><br>- Food, clothing, and other essential supplies<br></p>\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-black-outline\" href=\"#\" data-app-placeholder=\"Type Text\">\n                                READ MORE\n                            </a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper\">\n                    <h3 class=\"number-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showNumber\" data-app-selector=\".number-text\">\n                        <b>03</b>\n                    </h3>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText || showButtons\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Empowerment</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text, .mbr-section-btn\">- Life skills training (e.g., literacy, numeracy, independence)<br><br>- Confidence-building workshops<br><br>- Goal-setting and achievement programs<br><br>- Leadership development and mentorship<br><br>- Advocacy and support for rights and dignity.\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-black-outline\" href=\"#\" data-app-placeholder=\"Type Text\">\n                                READ MORE\n                            </a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrapper\">\n                    <h3 class=\"number-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showNumber\" data-app-selector=\".number-text\">\n                        <b>04</b>\n                    </h3>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText || showButtons\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            <b>Etiam erat </b>\n                        </h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text, .mbr-section-btn\">\n                            Ut faucibus pulvinar elementum integer enim neque volutpat.\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                            <a class=\"btn btn-black-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                READ MORE\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 4\">\n                <div class=\"card-wrapper\">\n                    <h3 class=\"number-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showNumber\" data-app-selector=\".number-text\">\n                        <b>05</b>\n                    </h3>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText || showButtons\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            <b>Habitasse platea</b>\n                        </h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text, .mbr-section-btn\">\n                            Odio ut sem nulla pharetra diam sit amet nisl suscipit.\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                            <a class=\"btn btn-black-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                READ MORE\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 5\">\n                <div class=\"card-wrapper\">\n                    <h3 class=\"number-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showNumber\" data-app-selector=\".number-text\">\n                        <b>06</b>\n                    </h3>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText || showButtons\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            <b>Vitae congue</b>\n                        </h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text, .mbr-section-btn\">\n                            Sagittis aliquam malesuada bibendum arcu vitae.\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                            <a class=\"btn btn-black-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                READ MORE\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_cid": "ukzU9bc8Tl",
          "_anchor": "afeatures7-19",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "max-width": "100%"
            },
            ".row": {
              "margin-left": "0",
              "margin-right": "0",
              "justify-content": "center",
              "> [class*=\"col\"]": {
                "padding-left": "0",
                "padding-right": "0"
              }
            },
            ".main-row": {
              "& when (@reverseContent)": {
                "flex-direction": "row-reverse"
              }
            },
            ".col-img": {
              "@media (max-width: 991px)": {
                "order": "2"
              }
            },
            ".item-img": {
              "height": "100%",
              "width": "100%",
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover"
              }
            },
            ".content-wrap": {
              "display": "flex",
              "align-items": "flex-start",
              "width": "100%",
              "padding": "75px 100px 130px 80px",
              "& when not (@fullWidth)": {
                "padding": "65px 60px 100px 40px"
              },
              "@media (max-width: 1439px)": {
                "padding": "55px 50px 100px 50px",
                "& when not (@fullWidth)": {
                  "padding": "35px 40px 70px 30px"
                }
              },
              "@media (max-width: 991px)": {
                "padding": "75px 80px 70px 80px",
                "& when not (@fullWidth)": {
                  "padding": "65px 40px 50px 40px"
                }
              },
              "@media (max-width: 767px)": {
                "padding": "70px 25px 70px 25px",
                "& when not (@fullWidth)": {
                  "padding": "60px 2px 50px 2px"
                }
              }
            },
            ".icon-wrap": {
              "margin-right": "15px",
              ".mbr-iconfont": {
                "font-size": "32px",
                "color": "@iconColor"
              }
            },
            ".tabs-wrap": {
              "flex-grow": "1"
            },
            ".mbr-text": {
              "margin-bottom": "30px",
              "color": "#64480b"
            },
            ".tabs-prof": {
              "color": "#64480b",
              "text-decoration": "underline"
            },
            ".tabs-name": {
              "margin-top": "6px",
              "color": "#503803"
            },
            ".nav-tabs .nav-item.open .nav-link:focus, .nav-tabs .nav-link.active:focus": {
              "outline": "none"
            },
            ".nav-tabs": {
              "flex-wrap": "wrap",
              "margin-top": "40px",
              "border": "none !important"
            },
            ".nav-item": {
              "margin-right": "25px"
            },
            ".nav-link": {
              "position": "relative",
              "padding": "0",
              "margin-bottom": "20px",
              "transition": "all .5s",
              "border": "none",
              "border-radius": "0 !important",
              "&:not(.active)": {
                "color": "@tabsColor"
              },
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "left": "0",
                "bottom": "0",
                "height": "2px",
                "width": "100%",
                "background-color": "currentColor",
                "transform": "scaleX(0)",
                "transform-origin": "left",
                "transition": "transform 1s cubic-bezier(0.33, 0.52, 0.05, 0.96)"
              },
              "&:hover": {
                "&:before": {
                  "transform": "scaleX(1)"
                }
              }
            },
            ".nav-tabs .nav-link.active": {
              "color": "@activeColor",
              "background-color": "transparent !important",
              "&:before": {
                "transform": "scaleX(1)"
              }
            }
          },
          "_name": "apeople1",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs people1 charitym5\" group=\"People\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-tabs\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#303030\" condition=\"showIcon\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" name=\"tabsColor\" title=\"Color\" value=\"#1a6001\">\n        <input type=\"color\" name=\"activeColor\" title=\"Active Color\" value=\"#000000\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#d0c689\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f6f6f6\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay&&bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center align-items-stretch main-row\">\n            <div class=\"col-12 col-lg-6 col-img\">\n                <div class=\"item-img\">\n                    <img src=\"@PROJECT_PATH@/assets/images/ordination.png\" alt=\"Mobirise Website Builder\">\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"content-wrap\">\n                    <div class=\"icon-wrap\" mbr-if=\"showIcon\">\n                        <a href=\"#\"><span mbr-icon class=\"mbr-iconfont imind-dove\" style=\"color: rgb(226, 226, 226); fill: rgb(226, 226, 226); font-size: 80px;\"></span></a>\n                    </div>\n                    <div class=\"tabs-wrap\">\n                        <div class=\"tab-content\">\n                            <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                                <div class=\"row\">\n                                    <div class=\"col-12\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-2\"><b>...Taking preys out of the lion's mouth.\"&nbsp;<br></b></p>\n                                        <p class=\"tabs-prof mbr-fonts-style mb-0\" data-app-selector=\".tabs-prof\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\"><b>- Isaiah 49:24-25</b><br><br></p>\n                                        <p class=\"tabs-name mbr-fonts-style mb-0\" data-app-selector=\".tabs-name\" mbr-theme-style=\"display-5\" mbr-if=\"showText\">Out of the above commission, Rock Messengers Outreach is born to deliver God's work as follows:<br><br><b>1. \"Prison Support\"\n<br><br>2. \"Hospital Aid\"\n<br><br>3. \"Disability Care\"\n<br><br>4. \"Rehab Support\"\n<br><br>5. \"Support for Widows\"</b><br></p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                                <div class=\"row\">\n                                    <div class=\"col-12\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-2\">\n                                            <b>Vel facilisis volutpat est velit egestas tristique nulla aliquet.</b>\n                                        </p>\n                                        <p class=\"tabs-prof mbr-fonts-style mb-0\" data-app-selector=\".tabs-prof\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\">\n                                            Volunteer\n                                        </p>\n                                        <p class=\"tabs-name mbr-fonts-style mb-0\" data-app-selector=\".tabs-name\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                            <b>Monica Murphy</b>\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                                <div class=\"row\">\n                                    <div class=\"col-12\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-2\">\n                                            <b>Diam quis enim lobortis scelerisque fermentum dui faucibus neque.</b>\n                                        </p>\n                                        <p class=\"tabs-prof mbr-fonts-style mb-0\" data-app-selector=\".tabs-prof\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\">\n                                            Manager\n                                        </p>\n                                        <p class=\"tabs-name mbr-fonts-style mb-0\" data-app-selector=\".tabs-name\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                            <b>Karen Watson</b>\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                                <div class=\"row\">\n                                    <div class=\"col-12\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-2\">\n                                            <b>Eget arcu dictum varius duis at consectetur lorem turpis massa.</b>\n                                        </p>\n                                        <p class=\"tabs-prof mbr-fonts-style mb-0\" data-app-selector=\".tabs-prof\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\">\n                                            Volunteer\n                                        </p>\n                                        <p class=\"tabs-name mbr-fonts-style mb-0\" data-app-selector=\".tabs-name\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                            <b>Isabella Perry</b>\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <ul class=\"nav nav-tabs\" role=\"tablist\" mbr-if=\"bootstrapTabs > 1\">\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item first mbr-fonts-style\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style show active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab1\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    <b>01</b>\n                                </a>\n                            </li>\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab2\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    <b>02</b>\n                                </a>\n                            </li>\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab3\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    <b>03</b>\n                                </a>\n                            </li>\n                            <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab4\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                                    <b>04</b>\n                                </a>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "ukzU9c26de",
          "_anchor": "apeople1-1a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".mbr-section-head": {
              "margin-bottom": "50px"
            },
            ".mbr-section-title": {
              "color": "#503803",
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "color": "#303030",
              "margin-top": "10px",
              "text-align": "center"
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".embla__slide": {
              "position": "relative",
              "display": "flex",
              "justify-content": "center",
              "min-width": "~\"calc(100vw / 3 - 60px)\"",
              "width": "~\"calc(100vw / 3 - 60px)\"",
              "margin": "0 30px",
              "& when (@showBorder)": {
                "border": "1px solid @borderColor"
              },
              "@media (max-width: 991px)": {
                "min-width": "50%",
                "width": "50%"
              },
              "@media (max-width: 768px)": {
                "min-width": "100%",
                "width": "100%"
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".slide-content": {
              "position": "relative",
              "border-radius": "0",
              "height": "100%",
              "display": "flex",
              "overflow": "hidden",
              "flex-flow": "column nowrap"
            },
            ".item-img": {
              "width": "100%",
              "img": {
                "width": "100%",
                "object-fit": "cover",
                "aspect-ratio": "~\"calc(408 / (114 * @{imageHeight}))\""
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "50%",
              "width": "60px",
              "height": "60px",
              "margin-top": "-1.5rem",
              "font-size": "22px",
              "background-color": "rgba(red(@arrowsColor), green(@arrowsColor), blue(@arrowsColor), 0.5)",
              "color": "#fff",
              "border": "2px solid #fff",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "background": "@arrowsColor",
                "color": "#FFFFFF"
              },
              "&.embla__button--prev": {
                "left": "0",
                "margin-left": "2.5rem"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "2.5rem"
              },
              "@media (max-width: 767px)": {
                "top": "auto"
              }
            }
          },
          "_name": "aslider1",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider1 charitym5 mbr-embla\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\" checked>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\">\n        <input type=\"color\" title=\"Arrows Color\" name=\"arrowsColor\" value=\"#9b8db7\" condition=\"arrows\">\n        <header>Cards</header>\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"6\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" name=\"showBorder\" title=\"Border\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#EAEAEA\" condition=\"showBorder\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div class=\"position-relative\">\n        <div class=\"container\">\n            <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n                <h4 class=\"mbr-section-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                    <b>SHOWREEL &amp; EVENTS ACTIVITIES</b></h4>\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\"><i>Donors impartation reel. This reel is not the intended activities, but our plans to the portal will be replaced with prove of concept.&nbsp;&nbsp;</i></h5>\n            </div>\n        </div>\n\n        <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n            <div class=\"embla__viewport\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n                <div class=\"embla__container\">\n\n                    <div class=\"embla__slide slider-image item\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/1458629-10201798323831639-452838195-n.jpg\" alt=\"Mobirise Website Builder\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n\n                    <div class=\"embla__slide slider-image item\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/mama-dav.jpg\" alt=\"Evangelist Pat.\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"embla__slide slider-image item\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/img-20170518-wa0004.jpg\" alt=\"Mobirise Website Builder\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"embla__slide slider-image item\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/pastordavid.jpg\" alt=\"Mobirise Website Builder\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"embla__slide slider-image item\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/img-20170518-wa0000.jpg\" alt=\"Mobirise Website Builder\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"embla__slide slider-image item\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/hospital-visitation.png\" alt=\"Mobirise Website Builder\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n            <button class=\"embla__button embla__button--prev\">\n                <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\n                <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n            </button>\n            <button class=\"embla__button embla__button--next\">\n                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\n                <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n            </button>\n        </div>\n    </div>\n</section>",
          "_cid": "ukzU9cRZmp",
          "_anchor": "aslider1-1b",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
