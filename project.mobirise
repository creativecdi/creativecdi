          "_name": "aform2",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form2 charitym5\" group=\"Form\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Main Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Main Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showItemTitle\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#eaeaea\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"mbr-section-head\" mbr-if=\"showMainTitle || showSubtitle\">\n            <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\" mbr-if=\"showMainTitle\">\n                <b>CCDI&nbsp;</b>Contact Form</h2>\n            <p class=\"mbr-section-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                Arcu non sodales neque sodales ut etiam sit amet nisl.\n            </p>\n        </div>\n        <div class=\"row \">\n            <div class=\"col-12 col-lg-6 col-text\">\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\"><i style><b>RMO</b> (Rock Messengers Outreach)<b> Reach out to </b></i><br><i style><b>us through our online message form for support, resources, or to learn more about our mission. </b></i><br><i style><b>Consider donating to help us empower and </b></i><br><i style><b>uplift those in need - every bit counts!\n                </b></i></p>\n                <div class=\"items-wrap\">\n                    <div class=\"item-wrap\">\n                        <p class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showItemTitle\" data-app-selector=\".item-title\">\n                            <b>Lagos State</b></p>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline=\"true\" data-app-edit=\"full\" mbr-article>\n                            <li class=\"item-text\" data-app-selector=\".list\">+234-8059423380</li>\n                            <li class=\"item-text\" data-app-selector=\".list\">LA@rockmessengers.org</li>\n                            <li class=\"item-text\" data-app-selector=\".list\">Ikorodu, Lagos<br>S/W Nigeria</li>\n                        </ul>\n                    </div>\n                    <div class=\"item-wrap\">\n                        <p class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showItemTitle\" data-app-selector=\".item-title\">\n                            <b>Abia State&nbsp;</b>(Ikwuano)</p>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline=\"true\" data-app-edit=\"full\" mbr-article>\n                            <li class=\"item-text\" data-app-selector=\".list\">+234-8063255444&nbsp;</li>\n                            <li class=\"item-text\" data-app-selector=\".list\">AB@rockmessengers.org</li>\n                            <li class=\"item-text\" data-app-selector=\".list\">Ikwuano, Abia<br>S/E Nigeria</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 col-form\">\n                <div class=\"form-wrap\">\n                    <div mbr-form class=\"mbr-form\">\n<!--Formbuilder Form-->\n<form action=\"support@ccdi.org\" name=\"Message from a Visitor to the Website:\" method=\"POST\" class=\"mbr-form form-with-styler mx-auto\" data-verified=\"support@ccdi.org\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for filling out Rock Messengers Outreach the messaging form!</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some problem! </div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"text\">\n<input type=\"text\" name=\"text\" placeholder=\"Name\" data-form-field=\"text\" mbr-theme-style=\"display-7\" class=\"form-control display-7\" value>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3 mb-3\" data-for=\"email\">\n<input type=\"email\" name=\"email\" placeholder=\"Email\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control display-7\" value>\n</div>\n<div data-for=\"tel-number\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<input type=\"number\" name=\"tel-number\" placeholder=\"Telephone Number\" data-form-field=\"tel-number\" mbr-theme-style=\"display-7\" class=\"form-control\" max=\"100\" min=\"0\" step=\"1\" required=\"required\" value>\n</div>\n<div data-for=\"message\" class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n<textarea name=\"message\" placeholder=\"Message\" data-form-field=\"message\" mbr-theme-style=\"display-7\" class=\"form-control display-7\"></textarea>\n</div>\n<div data-for=\"Support-form\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<div class=\"form-control-label\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"Support-form\" class=\"mbr-fonts-style\">Will You Support Our Cause? </label>\n</div>\n<div class=\"form-check form-check-inline ms-2\">\n<input type=\"radio\" name=\"Support-form\" data-form-field=\"Support-form\" mbr-theme-style=\"display-7\" class=\"form-check-input\" value=\"Please select appropriate option.\" checked>\n<label mbr-text mbr-theme-style=\"display-7\" class=\"form-check-label\">Please select appropriate option.</label>\n</div>\n<div class=\"form-check form-check-inline ms-2\">\n<input type=\"radio\" name=\"Support-form\" data-form-field=\"Support-form\" mbr-theme-style=\"display-7\" class=\"form-check-input\" value=\"YES\">\n<label mbr-text mbr-theme-style=\"display-7\" class=\"form-check-label\">YES</label>\n</div>\n<div class=\"form-check form-check-inline ms-2\">\n<input type=\"radio\" name=\"Support-form\" data-form-field=\"Support-form\" mbr-theme-style=\"display-7\" class=\"form-check-input\" value=\"WILL eMAIL\">\n<label mbr-text mbr-theme-style=\"display-7\" class=\"form-check-label\">WILL eMAIL</label>\n</div>\n<div class=\"form-check form-check-inline ms-2\">\n<input type=\"radio\" name=\"Support-form\" data-form-field=\"Support-form\" mbr-theme-style=\"display-7\" class=\"form-check-input\" value=\"SEND US ACCOUNT\">\n<label mbr-text mbr-theme-style=\"display-7\" class=\"form-check-label\">SEND ACCOUNT FOR DIRECT SUPPORT.</label>\n</div>\n</div>\n<div class=\"col-auto mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-5\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"w-100 w-100 w-100 w-100 w-100 w-100 btn btn-danger-outline\" data-app-placeholder=\"Type Text\"> SUBMIT </a></div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
