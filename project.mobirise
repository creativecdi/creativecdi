        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "overflow": "hidden",
            ".mbr-section-title": {
              "color": "#ffffff",
              "& when (@fullWidth)": {
                "display": "flex",
                "justify-content": "center",
                "white-space": "nowrap",
                "&.display-1": {
                  "font-size": "200px !important",
                  "line-height": "1 !important",
                  "@media (max-width: 991px)": {
                    "font-size": "130px !important"
                  },
                  "@media (max-width: 767px)": {
                    "font-size": "100px !important"
                  }
                }
              }
            },
            ".mbr-section-subtitle": {
              "color": "#303030"
            }
          },
          "_name": "aarticle1",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article1 charitym5\" group=\"Content\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" step=\"1\" value=\"12\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#024616\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFE2DA\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"title col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\">\"<b><i>Where Enterprise Meets Empowerment.\n</i></b><div><b><i>Purpose driven Lasting Community Impact</i></b>\"</div></h3>\n                <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-0 mt-3\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\">\n                    Molestie a iaculis at erat pellentesque.\n                </h4>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "ttjhAC1rdD",
          "_anchor": "aarticle1-2",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "overflow": "hidden",
            ".row": {
              "margin-left": "-30px",
              "margin-right": "-30px",
              "justify-content": "center",
              "row-gap": "60px",
              "> [class*=\"col\"]": {
                "padding-left": "30px",
                "padding-right": "30px"
              },
              "@media (max-width: 991px)": {
                "row-gap": "40px"
              }
            },
            ".mbr-section-head": {
              "padding-bottom": "50px"
            },
            ".mbr-section-title": {
              "color": "#9b8db7"
            },
            ".mbr-section-subtitle": {
              "color": "#303030",
              "margin-top": "16px"
            },
            ".item-img": {
              "position": "relative",
              "width": "100%",
              "overflow": "hidden",
              "img": {
                "width": "100%",
                "aspect-ratio": "~\"calc(131 / (59 * @{imgHeight}))\"",
                "object-fit": "cover",
                "transform": "scale(1.01)",
                "transition": "all .5s ease"
              }
            },
            ".mbr-section-btn": {
              "position": "absolute",
              "top": "100%",
              "left": "0",
              "display": "flex",
              "justify-content": "center",
              "width": "100%",
              "transition": "all .5s ease",
              "margin": "0 !important",
              "@media (max-width: 575px)": {
                "transform": "translateY(-100%)"
              },
              ".btn": {
                "width": "100%",
                "margin": "0 !important",
                "padding": "10px 34px 10px !important",
                "&:after": {
                  "bottom": "11px !important",
                  "width": "50% !important"
                }
              }
            },
            ".item-wrapper": {
              "width": "100%",
              "height": "100%",
              "padding": "0",
              "transition": ".3s all",
              "&:hover": {
                ".item-img": {
                  "img": {
                    "transform": "scale(1.05)"
                  }
                },
                ".mbr-section-btn": {
                  "transform": "translateY(-100%)"
                }
              },
              "@media (max-width: 767px)": {}
            },
            ".item-content": {
              "margin-top": "32px"
            },
            ".item-title": {
              "color": "#f00000"
            },
            ".mbr-text": {
              "margin-top": "11px",
              "color": "#303030"
            },
            ".item-number": {
              "color": "#003a03",
              "margin-top": "22px"
            },
            ".item-border": {
              "width": "100%",
              "height": "4px",
              "margin-top": "3px",
              "border-radius": "5px",
              "background-color": "@borderColor"
            },
            ".item-text-wrap": {
              "display": "flex",
              "align-items": "flex-start",
              "justify-content": "flex-start",
              "gap": "30px",
              "margin-top": "16px"
            },
            ".item-text": {
              "color": "#000000"
            }
          },
          "_name": "agallery3",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery3 charitym5\" group=\"Sliders & Galleries\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\" checked>\n        <header>Cards</header>\n        <input type=\"range\" inline title=\"Image Height\" name=\"imgHeight\" min=\"1\" max=\"5\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Button\" checked>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n        <input type=\"checkbox\" name=\"showNumber\" title=\"Number\" checked>\n        <input type=\"checkbox\" name=\"showBorder\" title=\"Border\" checked>\n        <input type=\"color\" name=\"borderColor\" title=\"Border Color\" value=\"#77ca0d\" condition=\"showBorder\">\n        <input type=\"checkbox\" name=\"showInfo\" title=\"Info\" checked>\n        <input type=\"range\" inline title=\"Info Count\" name=\"infoCount\" min=\"1\" max=\"2\" step=\"1\" value=\"2\" condition=\"showInfo\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#FFFFFF\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div class=\"container\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                <b>DIAM DONEC ADIPISCING</b>\n            </h4>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                Volutpat ac tincidunt vitae semper quis lectus nulla at volutpat.\n            </h5>\n        </div>\n        <div class=\"row items-row {{contentAlign}}\">\n            <div class=\"item features-image col-12 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/rockmessengers-hospital-visitation.png\" alt=\"Mobirise Website Builder\">\n                        <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"account.html#donation2Support44\" class=\"btn item-btn btn-black\" target=\"_blank\" data-app-placeholder=\"Type Text\">PLEASE DONATE</a></div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showInfo || showText || showBorder\">\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            <b>Hospital Visitation</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                            One-on-one support, mind and spirit. We provide financial assistance, prayerful support, and emotional comfort to patients at every hospitals we visit to pray, give cash, bringing <br>hope in times of need.\n                        </p>\n                        <h5 class=\"item-number mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".item-number\" mbr-if=\"showNumber\"><b>2.0%</b>\n                        </h5>\n                        <div class=\"item-border\" mbr-if=\"showBorder\"></div>\n                        <div class=\"item-text-wrap\" mbr-if=\"showInfo\">\n                            <p class=\"item-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                               Raised: 000,000.00₦</p>\n                            <p class=\"item-text mbr-fonts-style mb-0\" mbr-if=\"infoCount > 1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\"><b>\n                                Goal: ₦100M</b></p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mama.png\" alt=\"Mobirise Website Builder\">\n                        <div class=\"mbr-section-btn item-footer \" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"account.html#donation2Support44\" class=\"btn item-btn btn-black\" target=\"_blank\" data-app-placeholder=\"Type Text\">PLEASE DONATE&nbsp;</a></div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showInfo || showText || showBorder\">\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>Touching Hearts, Changing Lives</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                            Rock Messengers shares wisdom and care, supporting those in rehabilitation, trauma, and need. We help settle medical bills, empower widows and children, and provide hope and guidance to overcome adversity\n                        </p>\n                        <h5 class=\"item-number mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".item-number\" mbr-if=\"showNumber\"><b>3.0%</b>\n                        </h5>\n                        <div class=\"item-border\" mbr-if=\"showBorder\"></div>\n                        <div class=\"item-text-wrap\" mbr-if=\"showInfo\">\n                            <p class=\"item-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                Raised: 000,000.00₦\n                            </p>\n                            <p class=\"item-text mbr-fonts-style mb-0\" mbr-if=\"infoCount > 1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\"><b>Goal: ₦100M</b></p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-lg-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/put-smiles-on-their-faces.png\" alt=\"Mobirise Website Builder\">\n                        <div class=\"mbr-section-btn item-footer \" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"account.html#donation2Support44\" class=\"btn item-btn btn-black\" target=\"_blank\" data-app-placeholder=\"Type Text\">PLEASE DONATE&nbsp;</a></div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showInfo || showText || showBorder\">\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>Give Hope, Give Love</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Offer nutritious food and healthcare to nourish their bodies.&nbsp;Listen and counsel to heal emotional scars and bring hope.<br>Teach life skills and confidence to help them thrive. Show love, kindness, and compassion to fill their hearts.</p>\n                        <h5 class=\"item-number mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".item-number\" mbr-if=\"showNumber\">\n                            <b>5.0%</b>\n                        </h5>\n                        <div class=\"item-border\" mbr-if=\"showBorder\"></div>\n                        <div class=\"item-text-wrap\" mbr-if=\"showInfo\">\n                            <p class=\"item-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Raised: 000,000.00₦\n                            </p>\n                            <p class=\"item-text mbr-fonts-style mb-0\" mbr-if=\"infoCount > 1\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\"><b>\n                                Goal: ₦100M\n                            </b></p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "ttjhGLPdzJ",
          "_anchor": "agallery3-3",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-title, .mbr-section-subtitle": {
              "color": "#000000"
            },
            ".mbr-section-text": {
              "color": "#232323"
            },
            ".mbr-text, .typed-text, .mbr-section-text": {
              "letter-spacing": "0.03rem"
            },
            ".btn": {
              "margin-left": "4px !important"
            },
            ".animated-element": {
              "color": "@wordsColor"
            },
            ".typed-cursor": {
              "opacity": "1",
              "-webkit-animation": "blink 0.7s infinite",
              "-moz-animation": "blink 0.7s infinite",
              "animation": "blink 0.7s infinite",
              "color": "@wordsColor"
            },
            ".mbr-figure": {
              "border-radius": ".25rem",
              "overflow": "hidden"
            },
            "@media (max-width: 991px)": {
              ".mbr-figure": {
                "margin-top": "2rem"
              }
            },
            "@media (max-width: 767px)": {
              ".typed-text, .mbr-section-subtitle, .mbr-section-text, .mbr-section-btn": {
                "text-align": "center !important"
              }
            },
            "@keyframes blink": {
              "0%": {
                "opacity": "1"
              },
              "50%": {
                "opacity": "0"
              },
              "100%": {
                "opacity": "1"
              }
            },
            "@-webkit-keyframes blink": {
              "0%": {
                "opacity": "1"
              },
              "50%": {
                "opacity": "0"
              },
              "100%": {
                "opacity": "1"
              }
            },
            "@-moz-keyframes blink": {
              "0%": {
                "opacity": "1"
              },
              "50%": {
                "opacity": "0"
              },
              "100%": {
                "opacity": "1"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "header4",
          "_sourceTheme": "businessm4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header4 businessm4_header4\" group=\"Headers\" plugins=\"Typed\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"fullScreen\">\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Animated Text\" name=\"showAnimatedText\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" value=\"../_images/background6.jpg\" title=\"Image\" parallax selected>\n\t\t\t<input type=\"color\" value=\"#ffffff\" title=\"Color\">\n\t\t\t<input type=\"video\" value=\"https://youtu.be/iM-NestDPNQ\" title=\"Video\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f4f8fa\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<header codition=\"showSubtitle && showAnimatedText\">Animated Text Settings</header>\n\t\t<select title=\"Words Title\" name=\"wordsTitle\" condition=\"showSubtitle && showAnimatedText\">\n\t\t\t<option value=\"title1\">Title 1</option>\n\t\t\t<option value=\"title2\" selected>Title 2</option>\n\t\t\t<option value=\"title3\">Title 3</option>\n\t\t\t<option value=\"text\">Text</option>\n\t\t\t<option value=\"menu\">Menu</option>\n\t\t</select>\n\t\t<input type=\"color\" title=\"Words Color\" name=\"wordsColor\" value=\"#1dc9cb\" condition=\"showSubtitle && showAnimatedText\">\n\t\t<input type=\"range\" inline title=\"Type Speed\" name=\"typeSpeed\" min=\"1\" max=\"100\" value=\"50\" step=\"1\" condition=\"showSubtitle && showAnimatedText\">\n\t\t<input type=\"range\" inline title=\"Words Count\" name=\"wordsCount\" min=\"2\" max=\"5\" value=\"3\" step=\"1\" condition=\"showSubtitle && showAnimatedText\">\n\t\t<input type=\"text\" title=\"Word 1\" inline name=\"animatedWord1\" value=\"Responsive\" condition=\"showSubtitle && showAnimatedText\">\n\t\t<input type=\"text\" title=\"Word 2\" inline name=\"animatedWord2\" value=\"Clean\" condition=\"showSubtitle && showAnimatedText\">\n\t\t<input type=\"text\" title=\"Word 3\" inline name=\"animatedWord3\" value=\"Unique\" condition=\"showSubtitle &amp;&amp; showAnimatedText &amp;&amp; wordsCount > 2\">\n\t\t<input type=\"text\" title=\"Word 4\" inline name=\"animatedWord4\" value=\"Lorem\" condition=\"showSubtitle &amp;&amp; showAnimatedText &amp;&amp; wordsCount > 3\">\n\t\t<input type=\"text\" title=\"Word 5\" inline name=\"animatedWord5\" value=\"Ipsum\" condition=\"showSubtitle &amp;&amp; showAnimatedText &amp;&amp; wordsCount > 4\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"mbr-white col-md-12 col-lg-6\">\n\t\t\t\t<div class=\"typed-text pb-3 align-left\" mbr-class=\"{'display-1':wordsTitle=='title1','display-2':wordsTitle=='title2',\n                                      'display-5':wordsTitle=='title3','display-7':wordsTitle=='text',\n                                      'display-4':wordsTitle=='menu'}\" mbr-if=\"showSubtitle\">\n\t\t\t\t\t<span mbr-text class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-subtitle, .typed-text\">\n\t\t\t\t\t\tMobirise BusinessM4 theme is\n\t\t\t\t\t</span>\n\t\t\t\t\t<span mbr-if=\"showAnimatedText\">\n\t\t\t\t\t\t<span class=\"animated-element mbr-bold\" data-word1=\"{{animatedWord1}}\" data-word2=\"{{animatedWord2}}\" data-word3=\"{{animatedWord3}}\" data-word4=\"{{animatedWord4}}\" data-word5=\"{{animatedWord5}}\" data-speed=\"{{typeSpeed}}\" data-words=\"{{wordsCount}}\">\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</span>\n\t\t\t\t</div>\n\t\t\t\t<p class=\"mbr-section-text mbr-fonts-style align-left\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-section-text,.mbr-section-btn\">\n\t\t\t\t\tClean, light, responsive theme with gradients and shadows. Build websites to present your business\n\t\t\t\t\tand many more\n\t\t\t\t</p>\n\t\t\t\t<div mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\" mbr-if=\"showButtons\" class=\"pt-3 mbr-section-btn align-left\">\n\t\t\t\t\t<a class=\"btn-info btn btn-success btn-md\" type=\"submit\">Start Building</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-6\">\n\t\t\t\t<div class=\"mbr-figure\">\n\t\t\t\t\t<img src=\"../_images/img/02.png\" alt=\"Mobirise\" title>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div mbr-if=\"showArrow && fullScreen\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n\t\t<a href=\"#next\">\n\t\t\t<i class=\"mbri-down mbr-iconfont\"></i>\n\t\t</a>\n\t</div>\n</section>",
