          "_name": "amenu2",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu2 charitym5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"4.4\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#ffeb08\" condition=\"showBorder\">\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#024616\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ffc608\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://creativecdi.org\">\n                        <img src=\"@PROJECT_PATH@/assets/images/name-top-logo2.webp\" alt=\"The Creative Craft Development Initiative (CCDI)\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-warning\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">CCDI<br></a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <div>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                    <div>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                    <div></div>\n                    <div>\n                        <span></span>\n                        <span></span>\n                        <span></span>\n                    </div>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-white text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\"><span class=\"fa fa-home mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 25px; color: rgb(243, 223, 14);\"></span>HOME</a></li><li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link text-white dropdown-toggle show\" href=\"index.html#aheadavid-okem1-4\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\"><span class=\"fa fa-book mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(243, 223, 14);\"></span>ABOUT</a><div class=\"dropdown-menu show\" aria-labelledby=\"dropdown-943\" data-bs-popper=\"none\"><a class=\"text-white dropdown-item\" href=\"index.html#aheadavid-okem1-4\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">ABOUT CCDI</a><a class=\"text-white dropdown-item\" href=\"index.html#aheadavid-okem1-4\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">VISION AND MISSION&nbsp;</a><a class=\"text-white dropdown-item\" href=\"index.html#aheadavid-okem1-4\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">CORE VALUES</a><a class=\"text-white dropdown-item\" href=\"index.html#aheadavid-okem1-4\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">IMPACT STATISTICS</a><a class=\"text-white dropdown-item\" href=\"index.html#aheadavid-okem1-4\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">PARTNERSHIP</a></div>\n                    </li>\n                    <li class=\"nav-item dropdown\">\n                        <a class=\"nav-link link text-white dropdown-toggle\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\"><span class=\"mdi-notification-event-note mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(243, 223, 14);\"></span>PROJECTS</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-311\"><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">New Item</a><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">New Item</a><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">New Item</a><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\"><span class=\"mobi-mbri mobi-mbri-gift mbr-iconfont mbr-iconfont-btn\"></span>New Item</a></div>\n                    </li><li class=\"nav-item dropdown\"><a class=\"nav-link link text-white dropdown-toggle\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\"><span class=\"li_megaphone mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(243, 223, 14);\"></span>EXPLORE</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-981\"><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">New Item</a><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">New Item</a><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">New Item</a><a class=\"text-white dropdown-item\" href=\"https://web.facebook.com/profile.php?id=61563313566437&sk=friends_likes\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">New Item</a></div></li><li class=\"nav-item dropdown\"><a class=\"nav-link link dropdown-toggle text-white\" href=\"page5.html#eb-youtube-feed-2b\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\"><span class=\"fa fa-play-circle mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(243, 223, 14);\"></span>MEDIA</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-516\"><a class=\"dropdown-item text-white\" href=\"page5.html#eb-youtube-feed-2b\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\"><span class=\"mdi-av-videocam mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(255, 235, 8);\"></span>EVENT VIDEOS</a><a class=\"show dropdown-item text-white\" href=\"page5.html#eb-youtube-feed-2b\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\"><span class=\"li_camera mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(255, 235, 8);\"></span>PHOTO GALLERY</a><a class=\"text-white show dropdown-item\" href=\"page5.html#eb-youtube-feed-2b\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\"><span class=\"icon54-v2-design-document mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(255, 235, 8);\"></span>PDF DOCUMENTS</a><a class=\"text-white show dropdown-item\" href=\"page5.html#eb-youtube-feed-2b\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\"><span class=\"mdi-social-school mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(255, 235, 8);\"></span>CERTIFICATION</a></div></li><li class=\"nav-item\"><a class=\"nav-link link text-white\" href=\"contact.html#aform2-1k\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\"><span class=\"mdi-maps-pin-drop mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(243, 223, 14);\"></span>CONTACT</a></li></ul>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-danger\" href=\"account.html#donation2Support44\" data-app-placeholder=\"Type Text\">DONATION</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
