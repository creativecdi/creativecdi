        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-head": {
              "width": "100%",
              "margin-bottom": "30px"
            },
            ".mbr-section-title": {
              "color": "#503803",
              "margin-bottom": "0"
            },
            ".mbr-section-subtitle": {
              "color": "#503803",
              "margin-top": "16px"
            },
            ".mbr-iconfont": {
              "position": "relative",
              "font-size": "13px !important",
              "font-family": "'Moririse2' !important",
              "color": "@iconColor",
              "margin-left": "1rem",
              "padding": "7px",
              "transition": ".2s all",
              "&:after": {
                "content": "\"\"",
                "position": "absolute",
                "top": "50%",
                "left": "50%",
                "transform": "translate(-50%, -50%)",
                "width": "100%",
                "height": "100%",
                "border-radius": "50%",
                "background-color": "spin(saturate(lighten(@iconColor, 30%), 30%), 10)",
                "opacity": "1",
                "transition": ".2s all"
              },
              "&:before": {
                "position": "relative",
                "z-index": "2"
              }
            },
            ".panel-group": {
              "border": "none"
            },
            ".card": {
              "border-radius": "0",
              "&:not(:first-child)": {
                "margin-top": "12px",
                "border-top": "2px solid @borderColor"
              }
            },
            ".card-header": {
              "padding": "0",
              "border": "none",
              "background-color": "transparent",
              "margin-bottom": "0",
              "&:hover": {
                ".mbr-iconfont": {
                  "transform": "rotate(180deg)"
                }
              }
            },
            ".panel-title": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding": "12px 10px 20px 0",
              "color": "#303030",
              "transition": ".2s all",
              "&[aria-expanded=\"true\"]": {
                "padding": "12px 10px 13px 0",
                ".mbr-iconfont": {
                  "transform": "rotate(180deg)"
                }
              }
            },
            ".panel-title-edit": {
              "color": "#1a6001"
            },
            ".panel-body": {
              "padding": "0 0 30px"
            },
            ".panel-text": {
              "color": "#303030",
              "margin": "0"
            }
